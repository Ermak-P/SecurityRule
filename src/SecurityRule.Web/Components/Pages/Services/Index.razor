@page "/services"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation

<PageTitle>Сервисы</PageTitle>

<MudStack Row="true" Spacing="1">
    <MudText Typo="Typo.h4" GutterBottom="true">Сервисы</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                   Title="Добавить"
                   OnClick="@(() => Navigation.NavigateTo($"/services/create"))" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_services" />
}

@code {
    private IEnumerable<AppService> _services = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _services = await AppServiceRepository.GetAllAsync();
        _loading = false;
    }
}

@page "/services"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Сервисы</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Сервисы</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="@(() => Navigation.NavigateTo("/services/create"))" Class="mb-4">
    Добавить сервис
</MudButton>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_services" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Название</MudTh>
            <MudTh>Серверы</MudTh>
            <MudTh>AD учётная запись</MudTh>
            <MudTh>Сертификаты</MudTh>
            <MudTh>Открыть</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Название">@context.Name</MudTd>
            <MudTd DataLabel="Серверы">@string.Join(", ", context.Servers.Select(s => s.Name))</MudTd>
            <MudTd DataLabel="AD учётная запись">@context.AdAccountName</MudTd>
            <MudTd DataLabel="Сертификаты">@context.Certificates.Count</MudTd>
            <MudTd>
                <MudTooltip Text="Открыть в новом окне">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary"
                                   OnClick="@(() => OpenNewTab($"/services/{context.Id}"))" />
                </MudTooltip>
                <MudTooltip Text="Открыть в модальном окне">
                    <MudIconButton Icon="@Icons.Material.Filled.Pageview" Color="Color.Secondary"
                                   OnClick="@(() => OpenModal(context.Id))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<AppService> _services = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _services = await AppServiceRepository.GetAllAsync();
        _loading = false;
    }

    async Task OpenNewTab(string url) => await JS.InvokeVoidAsync("open", url, "_blank");

    async Task OpenModal(int id)
    {
        var parameters = new DialogParameters<ServiceDetailsDialog> { { p => p.ServiceId, id } };
        await DialogService.ShowAsync<ServiceDetailsDialog>("Сервис", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }
}

@page "/services"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation

<PageTitle>Сервисы</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Сервисы</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Управление сервисами и приложениями</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/services/create"))">Добавить</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_services" />
}

@code {
    private IEnumerable<AppService> _services = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _services = await AppServiceRepository.GetAllAsync();
        _loading = false;
    }
}

@page "/services/{Id:int}"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation

@if (_displayService == null)
{
    @if (!Embedded)
    {
        <PageTitle>Сервис — ...</PageTitle>
    }
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <PageTitle>Сервис — @_displayService.Name</PageTitle>
        <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Color="Color.Secondary" />
                <MudText Typo="Typo.h4">@_displayService.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/services/edit/{_displayService.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Учётная запись</MudText>
                    @if (!string.IsNullOrWhiteSpace(_displayService.UserName))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="@(_userExpanded ? Color.Primary : Color.Default)"
                                   StartIcon="@Icons.Material.Filled.AccountCircle"
                                   Style="margin-left: -6px;"
                                   OnClick="@ToggleUser">
                            @_displayService.UserName
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Color="Color.Secondary">—</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Порт</MudText>
                    <MudText Typo="Typo.body1">@(_displayService.Port.HasValue ? _displayService.Port.Value.ToString() : "—")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Серверов</MudText>
                    <MudText Typo="Typo.body1">@_displayService.Servers.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Сертификатов</MudText>
                    <MudText Typo="Typo.body1">@_displayService.Certificates.Count</MudText>
                </MudItem>
            </MudGrid>
            @if (_displayService.Certificates.Any())
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Class="mb-2"><strong>Сертификаты:</strong></MudText>
                @foreach (var cert in _displayService.Certificates)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">
                        @cert.Description (@cert.ExpiresAt.ToString("dd.MM.yyyy"))
                    </MudChip>
                }
            }
        </MudCardContent>
    </MudCard>

    @if (_userExpanded && !string.IsNullOrWhiteSpace(_displayService.UserName))
    {
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Class="mr-1" />
            Учётная запись
        </MudText>
        <MudPaper Elevation="2" Class="overflow-hidden mb-4" style="border-left: 3px solid var(--mud-palette-tertiary);">
            @if (_displayService.UserId.HasValue)
            {
                <SecurityRule.Web.Components.Pages.Users.Details Id="@_displayService.UserId.Value" Embedded="true" />
            }
            else
            {
                <SecurityRule.Web.Components.Pages.Users.Details UserName="@_displayService.UserName" Embedded="true" />
            }
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Class="mr-1" />
        Серверы
    </MudText>
    <MudPaper Elevation="2" Class="overflow-hidden mb-4">
        <SecurityRule.Web.Components.Pages.Servers.Table Items="@_displayService.Servers" Elevation="0" />
    </MudPaper>

    @if (_displayService.SourceConnections.Any() || _displayService.DestinationConnections.Any())
    {
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Size="Size.Small" Class="mr-1" />
            Связи
        </MudText>
        <MudPaper Elevation="2" Class="overflow-hidden">
            <SecurityRule.Web.Components.Pages.FirewallRules.Table
                Items="@(_displayService.SourceConnections.Concat(_displayService.DestinationConnections))"
                Elevation="0" />
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public AppService? Service { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;

    private AppService? _displayService;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private bool _userExpanded;

    protected override async Task OnInitializedAsync()
    {
        if (Service is not null)
        {
            _displayService = Service;
        }
        else
        {
            _displayService = await AppServiceRepository.GetByIdAsync(Id);
            _breadcrumbs =
            [
                new BreadcrumbItem("Сервисы", href: "/services"),
                new BreadcrumbItem(_displayService?.Name ?? Id.ToString(), href: null, disabled: true)
            ];
        }
    }

    private void ToggleUser() => _userExpanded = !_userExpanded;
}

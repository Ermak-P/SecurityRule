@page "/services/{Id:int}"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation

<PageTitle>Сервис — @(_service?.Name ?? "...")</PageTitle>

@if (_service == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
    <ServiceDetails Service="_service" />
}

@code {
    [Parameter] public int Id { get; set; }
    private AppService? _service;

    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _service = await AppServiceRepository.GetByIdAsync(Id);
        _breadcrumbs =
        [
            new BreadcrumbItem("Сервисы", href: "/services"),
            new BreadcrumbItem(_service?.Name ?? Id.ToString(), href: null, disabled: true)
        ];
    }
}

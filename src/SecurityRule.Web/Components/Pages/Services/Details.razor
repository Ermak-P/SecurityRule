@page "/services/{Id:int}"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Сервис — @(_service?.Name ?? "...")</PageTitle>

@if (_service == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Color="Color.Secondary" />
            <MudText Typo="Typo.h4">@_service.Name</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Navigation.NavigateTo($"/services/edit/{_service.Id}"))">
            Редактировать
        </MudButton>
    </MudStack>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">AD учётная запись</MudText>
                    <MudText Typo="Typo.body1">@_service.AdAccountName</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Серверов</MudText>
                    <MudText Typo="Typo.body1">@_service.Servers.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Сертификатов</MudText>
                    <MudText Typo="Typo.body1">@_service.Certificates.Count</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Dns" Class="mr-1" />
        Серверы
    </MudText>

    @if (!_service.Servers.Any())
    {
        <MudAlert Severity="Severity.Info">Сервис не привязан ни к одному серверу</MudAlert>
    }
    else
    {
        <MudTable T="Server" Items="@_service.Servers" Hover="true" Striped="true" Dense="true" OnRowClick="@ToggleServerRow">
            <HeaderContent>
                <MudTh>Название</MudTh>
                <MudTh>IP адрес</MudTh>
                <MudTh>Операционная система</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Название">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@(_expandedServerRows.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                        @context.Name
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="IP адрес">@context.IpAddress</MudTd>
                <MudTd DataLabel="Операционная система">@context.OperatingSystem</MudTd>
            </RowTemplate>
            <ChildRowContent Context="srv">
                @if (_expandedServerRows.Contains(srv.Id))
                {
                    <MudTr>
                        <td colspan="3" style="padding: 8px 16px 16px 40px; background: var(--mud-palette-background-grey);">
                            <MudText Typo="Typo.body2"><strong>IP адрес:</strong> @srv.IpAddress</MudText>
                            <MudText Typo="Typo.body2"><strong>Операционная система:</strong> @srv.OperatingSystem</MudText>
                            <MudText Typo="Typo.body2"><strong>Сервисов:</strong> @srv.Services.Count</MudText>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private AppService? _service;

    private List<BreadcrumbItem> _breadcrumbs = [];
    private readonly HashSet<int> _expandedServerRows = [];

    protected override async Task OnInitializedAsync()
    {
        _service = await AppServiceRepository.GetByIdAsync(Id);
        _breadcrumbs =
        [
            new BreadcrumbItem("Серверы и сервисы", href: "/servers-and-services"),
            new BreadcrumbItem("Сервисы", href: "/services"),
            new BreadcrumbItem(_service?.Name ?? Id.ToString(), href: null, disabled: true)
        ];
    }

    private void ToggleServerRow(TableRowClickEventArgs<Server> args)
    {
        if (args.Item is null) return;
        var id = args.Item.Id;
        if (!_expandedServerRows.Remove(id))
            _expandedServerRows.Add(id);
    }
}

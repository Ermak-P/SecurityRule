@page "/services/edit/{Id:int}"
@rendermode InteractiveServer
@inject IAppServiceRepository AppServiceRepository
@inject IServerRepository ServerRepository
@inject IUserRepository UserRepository
@inject ITagRepository TagRepository
@inject IPartnerNameRepository PartnerNameRepository
@inject IAgeOptionRepository AgeOptionRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Редактировать сервис</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Редактировать сервис</MudText>

@if (_service == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudTextField @bind-Value="_service.Name" Label="Название" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_portText" Label="Порт" Class="mb-3"
                          InputType="InputType.Number" />
            <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_selectedServerIds"
                       Label="Серверы" Class="mb-3">
                @foreach (var server in _allServers)
                {
                    <MudSelectItem Value="@server.Id">@server.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_selectedUserId" Label="AD учётная запись" Clearable="true" Class="mb-3">
                <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                @foreach (var user in _allUsers)
                {
                    <MudSelectItem T="int?" Value="@((int?)user.Id)">@user.Name</MudSelectItem>
                }
            </MudSelect>
            <TagInput AllTags="@_allTagNames" @bind-SelectedTags="_selectedTags" Class="mb-3" />
            <PartnerInput @bind-SelectedPartners="_selectedPartners" Class="mb-3" />
            <PartnerAgeRangeInput SelectedPartners="_selectedPartners"
                                  AgeRanges="_ageRanges"
                                  AgeRangesChanged="@(v => _ageRanges = v)"
                                  AllAgeOptions="_allAgeOptions"
                                  Class="mb-3" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo($"/services/{Id}"))">Отмена</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@Delete">
                Удалить
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    private AppService? _service;
    private IEnumerable<Server> _allServers = [];
    private IEnumerable<User> _allUsers = [];
    private IReadOnlyCollection<int> _selectedServerIds = [];
    private int? _selectedUserId;
    private string _portText = string.Empty;
    private IEnumerable<string> _allTagNames = [];
    private HashSet<string> _selectedTags = [];
    private HashSet<string> _selectedPartners = [];
    private IReadOnlyList<int> _allAgeOptions = [];
    private List<PartnerAgeRange> _ageRanges = [];

    protected override async Task OnInitializedAsync()
    {
        _service = await AppServiceRepository.GetByIdAsync(Id);
        _allServers = await ServerRepository.GetAllAsync();
        _allUsers = await UserRepository.GetAllAsync();
        _allTagNames = (await TagRepository.GetAllAsync()).Select(t => t.Name);
        _allAgeOptions = await AgeOptionRepository.GetAllValuesAsync();
        if (_service != null)
        {
            _selectedServerIds = _service.Servers.Select(s => s.Id).ToList();
            _selectedUserId = _service.UserId;
            _portText = _service.Port?.ToString() ?? string.Empty;
            _selectedTags = _service.Tags.Select(t => t.Name).ToHashSet();
            _selectedPartners = _service.Partners.Select(p => p.Name).ToHashSet();
            _ageRanges = _service.PartnerAgeRanges
                .Select(r => new PartnerAgeRange { PartnerName = r.PartnerName, AgeFrom = r.AgeFrom, AgeTo = r.AgeTo })
                .ToList();
        }
    }

    private async Task Save()
    {
        if (_service != null)
        {
            _service.Servers = _allServers.Where(s => _selectedServerIds.Contains(s.Id)).ToList();
            var selectedUser = _allUsers.FirstOrDefault(u => u.Id == _selectedUserId);
            _service.UserId = selectedUser?.Id;
            _service.UserName = selectedUser?.Name ?? string.Empty;
            _service.Port = int.TryParse(_portText, out var p) ? p : null;
            _service.Tags = [];
            foreach (var tagName in _selectedTags)
                _service.Tags.Add(await TagRepository.GetOrCreateAsync(tagName));
            _service.Partners = [];
            foreach (var partnerName in _selectedPartners)
                _service.Partners.Add(await PartnerNameRepository.GetOrCreateAsync(partnerName));
            _service.PartnerAgeRanges = _ageRanges
                .Where(r => _selectedPartners.Contains(r.PartnerName))
                .Select(r => new PartnerAgeRange { PartnerName = r.PartnerName, AgeFrom = r.AgeFrom, AgeTo = r.AgeTo })
                .ToList();
            await AppServiceRepository.UpdateAsync(_service);
            Snackbar.Add("Сервис обновлён", Severity.Success);
            Navigation.NavigateTo($"/services/{Id}");
        }
    }

    private async Task Delete()
    {
        try
        {
            await AppServiceRepository.DeleteAsync(Id);
            Snackbar.Add("Сервис удалён", Severity.Success);
            Navigation.NavigateTo("/services");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении сервиса: {ex.Message}", Severity.Error);
        }
    }
}

@page "/servers-and-services"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation

<PageTitle>Серверы и сервисы</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Серверы и сервисы</MudText>

<MudGrid Class="mb-4">
    <MudItem>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/servers/create"))">
            Добавить сервер
        </MudButton>
    </MudItem>
    <MudItem>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/services/create"))">
            Добавить сервис
        </MudButton>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="По серверам" Icon="@Icons.Material.Filled.Dns">
            @foreach (var server in _servers)
            {
                <MudExpansionPanels Class="mb-3">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1"><strong>@server.Name</strong></MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@server.IpAddress</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@server.OperatingSystem</MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (!server.Services.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">Нет сервисов</MudText>
                            }
                            else
                            {
                                <MudTable T="AppService" Items="@server.Services" Hover="true" Dense="true" Elevation="0"
                                          OnRowClick="@ToggleServiceRowInServer">
                                    <HeaderContent>
                                        <MudTh>Сервис</MudTh>
                                        <MudTh>AD учётная запись</MudTh>
                                        <MudTh>Сертификаты</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Сервис">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@(_expandedServiceRowsInServer.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                                                <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Size="Size.Small" />
                                                @context.Name
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="AD учётная запись">@context.AdAccountName</MudTd>
                                        <MudTd DataLabel="Сертификаты">@context.Certificates.Count</MudTd>
                                    </RowTemplate>
                                    <ChildRowContent Context="svc">
                                        @if (_expandedServiceRowsInServer.Contains(svc.Id))
                                        {
                                            <MudTr>
                                                <td colspan="3" style="padding: 8px 16px 8px 40px; background: var(--mud-palette-background-grey);">
                                                    <MudText Typo="Typo.body2"><strong>AD учётная запись:</strong> @svc.AdAccountName</MudText>
                                                    @if (svc.Certificates.Any())
                                                    {
                                                        <MudText Typo="Typo.body2" Class="mt-1"><strong>Сертификаты:</strong></MudText>
                                                        @foreach (var cert in svc.Certificates)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">@cert.Description (@cert.ExpiresAt.ToString("dd.MM.yyyy"))</MudChip>
                                                        }
                                                    }
                                                </td>
                                            </MudTr>
                                        }
                                    </ChildRowContent>
                                </MudTable>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            @if (!_servers.Any())
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">Серверы не найдены</MudText>
            }
        </MudTabPanel>

        <MudTabPanel Text="Все сервисы" Icon="@Icons.Material.Filled.MiscellaneousServices">
            <MudTable T="AppService" Items="@_services" Hover="true" Striped="true" Dense="true" OnRowClick="@ToggleServiceRow">
                <HeaderContent>
                    <MudTh>Название</MudTh>
                    <MudTh>Серверы</MudTh>
                    <MudTh>AD учётная запись</MudTh>
                    <MudTh>Сертификаты</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Название">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@(_expandedServiceRows.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                            @context.Name
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Серверы">
                        @foreach (var s in context.Servers)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mr-1">@s.Name</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="AD учётная запись">@context.AdAccountName</MudTd>
                    <MudTd DataLabel="Сертификаты">@context.Certificates.Count</MudTd>
                </RowTemplate>
                <ChildRowContent Context="svc">
                    @if (_expandedServiceRows.Contains(svc.Id))
                    {
                        <MudTr>
                            <td colspan="4" style="padding: 8px 16px 16px 40px; background: var(--mud-palette-background-grey);">
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">AD учётная запись</MudText>
                                        <MudText Typo="Typo.body2">@svc.AdAccountName</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Серверов</MudText>
                                        <MudText Typo="Typo.body2">@svc.Servers.Count</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Сертификатов</MudText>
                                        <MudText Typo="Typo.body2">@svc.Certificates.Count</MudText>
                                    </MudItem>
                                </MudGrid>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Все серверы" Icon="@Icons.Material.Filled.Storage">
            <MudTable T="Server" Items="@_servers" Hover="true" Striped="true" Dense="true" OnRowClick="@ToggleServerRow">
                <HeaderContent>
                    <MudTh>Название</MudTh>
                    <MudTh>IP адрес</MudTh>
                    <MudTh>Операционная система</MudTh>
                    <MudTh>Сервисы</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Название">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@(_expandedServerRows.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                            @context.Name
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="IP адрес">@context.IpAddress</MudTd>
                    <MudTd DataLabel="Операционная система">@context.OperatingSystem</MudTd>
                    <MudTd DataLabel="Сервисы">@context.Services.Count</MudTd>
                </RowTemplate>
                <ChildRowContent Context="srv">
                    @if (_expandedServerRows.Contains(srv.Id))
                    {
                        <MudTr>
                            <td colspan="4" style="padding: 8px 16px 16px 40px; background: var(--mud-palette-background-grey);">
                                <MudGrid>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">IP адрес</MudText>
                                        <MudText Typo="Typo.body2">@srv.IpAddress</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Операционная система</MudText>
                                        <MudText Typo="Typo.body2">@srv.OperatingSystem</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Сервисов</MudText>
                                        <MudText Typo="Typo.body2">@srv.Services.Count</MudText>
                                    </MudItem>
                                </MudGrid>
                                @if (srv.Services.Any())
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Сервисы:</MudText>
                                    @foreach (var svc in srv.Services)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">@svc.Name</MudChip>
                                    }
                                }
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private IList<Server> _servers = [];
    private IList<AppService> _services = [];
    private bool _loading = true;
    private readonly HashSet<int> _expandedServerRows = [];
    private readonly HashSet<int> _expandedServiceRows = [];
    private readonly HashSet<int> _expandedServiceRowsInServer = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _servers = (await ServerRepository.GetAllAsync()).ToList();
        _services = (await AppServiceRepository.GetAllAsync()).ToList();
        _loading = false;
    }

    private void ToggleServerRow(TableRowClickEventArgs<Server> args)
    {
        if (args.Item is null) return;
        var id = args.Item.Id;
        if (!_expandedServerRows.Remove(id))
            _expandedServerRows.Add(id);
    }

    private void ToggleServiceRow(TableRowClickEventArgs<AppService> args)
    {
        if (args.Item is null) return;
        var id = args.Item.Id;
        if (!_expandedServiceRows.Remove(id))
            _expandedServiceRows.Add(id);
    }

    private void ToggleServiceRowInServer(TableRowClickEventArgs<AppService> args)
    {
        if (args.Item is null) return;
        var id = args.Item.Id;
        if (!_expandedServiceRowsInServer.Remove(id))
            _expandedServiceRowsInServer.Add(id);
    }
}

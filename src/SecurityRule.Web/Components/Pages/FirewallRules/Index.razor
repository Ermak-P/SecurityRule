@page "/firewall-rules"
@rendermode InteractiveServer
@inject IFirewallRuleRepository FirewallRuleRepository
@inject NavigationManager Navigation

<PageTitle>Правила фаервола</PageTitle>

<MudStack Row="true" Spacing="1">
    <MudText Typo="Typo.h4" GutterBottom="true">Правила фаервола</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                   Title="Добавить"
                   OnClick="@(() => Navigation.NavigateTo($"/firewall-rules/create"))" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_rules" />
}

@code {
    private IEnumerable<FirewallRule> _rules = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _rules = await FirewallRuleRepository.GetAllAsync();
        _loading = false;
    }
}

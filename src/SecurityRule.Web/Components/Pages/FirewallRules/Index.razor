@page "/connections"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject NavigationManager Navigation

<PageTitle>Связи</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Связи</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Сетевые связи между сервисами</MudText>
    </div>
    <MudStack Row="true" Spacing="1">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                   OnClick="@(() => Navigation.NavigateTo("/connections/map"))">Карта связей</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/connections/create"))">Добавить</MudButton>
    </MudStack>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_connections" />
}

@code {
    private IEnumerable<ServiceConnection> _connections = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _connections = await ServiceConnectionRepository.GetAllAsync();
        _loading = false;
    }
}

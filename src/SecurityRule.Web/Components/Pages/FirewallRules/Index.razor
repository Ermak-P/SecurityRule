@page "/connections"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject NavigationManager Navigation

<PageTitle>Связи</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <MudText Typo="Typo.h4" GutterBottom="true">Связи</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                   Title="Добавить"
                   OnClick="@(() => Navigation.NavigateTo($"/connections/create"))" />
    <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Primary"
                   Title="Карта связей"
                   OnClick="@(() => Navigation.NavigateTo($"/connections/map"))" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_connections" />
}

@code {
    private IEnumerable<ServiceConnection> _connections = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _connections = await ServiceConnectionRepository.GetAllAsync();
        _loading = false;
    }
}

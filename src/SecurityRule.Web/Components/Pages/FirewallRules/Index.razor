@page "/firewall-rules"
@rendermode InteractiveServer
@inject IFirewallRuleRepository FirewallRuleRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Правила фаервола</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Правила фаервола</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="@(() => Navigation.NavigateTo("/firewall-rules/create"))" Class="mb-4">
    Добавить правило
</MudButton>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_rules" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Исходящий IP</MudTh>
            <MudTh>Входящий IP</MudTh>
            <MudTh>Истекает</MudTh>
            <MudTh>Статус</MudTh>
            <MudTh>Описание</MudTh>
            <MudTh>Действия</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Исходящий IP">@context.SourceIp</MudTd>
            <MudTd DataLabel="Входящий IP">@context.DestinationIp</MudTd>
            <MudTd DataLabel="Истекает">@context.ExpiresAt.ToString("dd.MM.yyyy")</MudTd>
            <MudTd DataLabel="Статус">
                @if (context.ExpiresAt < DateTime.Now)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Истёк</MudChip>
                }
                else if (context.ExpiresAt < DateTime.Now.AddDays(30))
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Скоро истекает</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Активен</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Описание">@context.Description</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo($"/firewall-rules/edit/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => DeleteRule(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<FirewallRule> _rules = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _rules = await FirewallRuleRepository.GetAllAsync();
        _loading = false;
    }

    private async Task DeleteRule(int id)
    {
        await FirewallRuleRepository.DeleteAsync(id);
        Snackbar.Add("Правило удалено", Severity.Success);
        await LoadData();
    }
}

@page "/connections/map"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject IJSRuntime JS

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @* Hidden server list used by E2E tests to verify options without opening the dropdown *@
    <div style="display:none" data-testid="server-filter-options">
        @foreach (var s in _allServers)
        {
            <span>@s.Name (@s.IpAddress)</span>
        }
    </div>

    @* Hidden list of currently dimmed (related) servers for E2E assertions *@
    <div style="display:none" data-testid="graph-dimmed-servers">
        @foreach (var srvId in _relatedServerIds)
        {
            var srv = _allServers.First(s => s.Id == srvId);
            <span>@srv.Name@(string.IsNullOrWhiteSpace(srv.IpAddress) ? "" : $" ({srv.IpAddress})")</span>
        }
    </div>

    <MudGrid Spacing="3">
        @* Graph + Legend *@
        <MudItem xs="12" md="9">
            <MudPaper Elevation="1" Style="height: 620px;" data-testid="connections-map-container">
                <div id="cy-container" style="width: 100%; height: 100%;" data-testid="connections-graph"></div>
            </MudPaper>

            @* Legend *@
            <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <div style="width:22px; height:14px; background:#e8f4fc; border:2px solid #1565c0; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Сервер</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <div style="width:22px; height:14px; background:#f5f5f5; border:1.5px dashed #b0bec5; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Связанный сервер</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <div style="width:22px; height:14px; background:#ffffff; border:1.5px solid #42a5f5; border-radius:4px;"></div>
                        <MudText Typo="Typo.caption">Сервис</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="leg-srv" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                                    <polygon points="0 0, 6 2.5, 0 5" fill="#1565c0" />
                                </marker>
                            </defs>
                            <line x1="0" y1="6" x2="22" y2="6" stroke="#1565c0" stroke-width="1.5" marker-end="url(#leg-srv)" />
                        </svg>
                        <MudText Typo="Typo.caption">Связь от сервера</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="leg-svc" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                                    <polygon points="0 0, 6 2.5, 0 5" fill="#00796b" />
                                </marker>
                            </defs>
                            <line x1="0" y1="6" x2="22" y2="6" stroke="#00796b" stroke-width="1.5" marker-end="url(#leg-svc)" />
                        </svg>
                        <MudText Typo="Typo.caption">Связь от сервиса</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* Filter panel – servers only (right side) *@
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Фильтр по серверам:</MudText>
                <MudStack Row="true" Spacing="1" Class="mb-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAll">Выбрать все</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="DeselectAll">Снять все</MudButton>
                </MudStack>
                <div data-testid="server-filter-chips">
                    <MudChipSet T="int" SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedServerIds"
                                SelectedValuesChanged="OnServersChanged"
                                Class="d-flex flex-column align-start">
                        @foreach (var s in _allServers)
                        {
                            <MudChip T="int" Value="@s.Id" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                @s.Name@(string.IsNullOrWhiteSpace(s.IpAddress) ? "" : $" ({s.IpAddress})")
                            </MudChip>
                        }
                    </MudChipSet>
                </div>
                <div data-testid="show-related-checkbox">
                    <MudCheckBox T="bool" Value="_showRelated" ValueChanged="OnShowRelatedChanged"
                                 Label="Показывать связанные серверы" Class="mt-2" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private bool _graphInitialized = false;
    private bool _showRelated = false;

    private IReadOnlyCollection<int> _selectedServerIds = [];
    private HashSet<int> _relatedServerIds = [];

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _allConnections = await ServiceConnectionRepository.GetAllAsync();
        _allServers     = await ServerRepository.GetAllAsync();
        _allServices    = await AppServiceRepository.GetAllAsync();
        _selectedServerIds = _allServers.Select(s => s.Id).ToList();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_graphInitialized)
        {
            _graphInitialized = true;
            var elements = BuildElements();
            await JS.InvokeVoidAsync("graphMap.init", "cy-container", elements);
        }
    }

    private async Task SelectAll()
    {
        _selectedServerIds = _allServers.Select(s => s.Id).ToList();
        await RefreshGraph();
    }

    private async Task DeselectAll()
    {
        _selectedServerIds = [];
        await RefreshGraph();
    }

    private async Task OnServersChanged(IReadOnlyCollection<int> values)
    {
        _selectedServerIds = values;
        await RefreshGraph();
    }

    private async Task OnShowRelatedChanged(bool value)
    {
        _showRelated = value;
        await RefreshGraph();
    }

    private async Task RefreshGraph()
    {
        if (_graphInitialized)
        {
            var elements = BuildElements();
            // Wrap in object[] so the params overload passes 'elements' as a single JS argument.
            await JS.InvokeVoidAsync("graphMap.update", new object[] { elements });
        }
    }

    // ── Build Cytoscape elements ──────────────────────────────────────────────
    private object[] BuildElements()
    {
        var selectedIds = _selectedServerIds.ToHashSet();

        var primaryServers = selectedIds.Count == 0
            ? _allServers.ToList()
            : _allServers.Where(s => selectedIds.Contains(s.Id)).ToList();

        var primaryServerIds = primaryServers.Select(s => s.Id).ToHashSet();

        // Build service→server lookup to infer server when DestinationServerId is not set.
        var svcToSrvId = new Dictionary<int, int>();
        foreach (var srv in _allServers)
            foreach (var svc in srv.Services)
                svcToSrvId.TryAdd(svc.Id, srv.Id);

        // Helper: resolve the effective server for a connection endpoint.
        int? EffectiveServer(int? explicitServerId, int? serviceId)
        {
            if (explicitServerId.HasValue) return explicitServerId;
            if (serviceId.HasValue && svcToSrvId.TryGetValue(serviceId.Value, out int sid)) return sid;
            return null;
        }

        // Find related servers: connected to a primary server but not selected.
        var relatedServerIdSet = new HashSet<int>();
        if (_showRelated && primaryServerIds.Count > 0 && selectedIds.Count > 0)
        {
            foreach (var conn in _allConnections)
            {
                int? srcSrv = EffectiveServer(conn.SourceServerId, conn.SourceServiceId);
                int? dstSrv = EffectiveServer(conn.DestinationServerId, conn.DestinationServiceId);

                if (srcSrv.HasValue && primaryServerIds.Contains(srcSrv.Value)
                    && dstSrv.HasValue && !primaryServerIds.Contains(dstSrv.Value))
                    relatedServerIdSet.Add(dstSrv.Value);

                if (dstSrv.HasValue && primaryServerIds.Contains(dstSrv.Value)
                    && srcSrv.HasValue && !primaryServerIds.Contains(srcSrv.Value))
                    relatedServerIdSet.Add(srcSrv.Value);
            }
        }
        _relatedServerIds = relatedServerIdSet;

        var relatedServers  = _allServers.Where(s => relatedServerIdSet.Contains(s.Id)).ToList();
        var allVisibleServers = primaryServers.Concat(relatedServers).ToList();
        var allVisibleServerIds = allVisibleServers.Select(s => s.Id).ToHashSet();

        var elements = new List<object>();

        // Primary server compound nodes
        foreach (var srv in primaryServers.OrderBy(s => s.Name))
            elements.Add(CreateServerElement(srv, dimmed: false));

        // Related (dimmed) server compound nodes
        foreach (var srv in relatedServers.OrderBy(s => s.Name))
            elements.Add(CreateServerElement(srv, dimmed: true));

        // Service nodes (children of their servers)
        var addedServiceIds = new HashSet<int>();
        foreach (var srv in allVisibleServers.OrderBy(s => s.Name))
        {
            bool isDimmed = relatedServerIdSet.Contains(srv.Id);
            foreach (var svc in srv.Services.OrderBy(s => s.Name))
            {
                if (addedServiceIds.Add(svc.Id))
                {
                    elements.Add(new
                    {
                        data = new
                        {
                            id     = $"svc-{svc.Id}",
                            label  = svc.Name,
                            parent = $"srv-{srv.Id}",
                            type   = "service",
                            @class = "macromolecule",
                            dimmed = isDimmed ? "1" : "0",
                            stateVariables    = Array.Empty<object>(),
                            unitsOfInformation = Array.Empty<object>(),
                            clonemarker       = false
                        }
                    });
                }
            }
        }

        // Edges – between visible servers (using effective server IDs to handle null DestinationServerId)
        foreach (var conn in _allConnections)
        {
            int? srcSrv = EffectiveServer(conn.SourceServerId, conn.SourceServiceId);
            int? dstSrv = EffectiveServer(conn.DestinationServerId, conn.DestinationServiceId);

            bool srcInScope = srcSrv.HasValue && allVisibleServerIds.Contains(srcSrv.Value);
            bool dstInScope = dstSrv.HasValue && allVisibleServerIds.Contains(dstSrv.Value);
            if (!srcInScope || !dstInScope) continue;

            string srcNodeId = conn.SourceServiceId.HasValue && addedServiceIds.Contains(conn.SourceServiceId.Value)
                ? $"svc-{conn.SourceServiceId.Value}"
                : $"srv-{srcSrv.GetValueOrDefault()}";

            string dstNodeId = addedServiceIds.Contains(conn.DestinationServiceId)
                ? $"svc-{conn.DestinationServiceId}"
                : $"srv-{dstSrv.GetValueOrDefault()}";

            bool fromService = conn.SourceServiceId.HasValue;
            string label = BuildEdgeLabel(
                conn.DestinationService?.Port
                    ?? _allServices.FirstOrDefault(s => s.Id == conn.DestinationServiceId)?.Port,
                conn.Protocol);

            elements.Add(new
            {
                data = new
                {
                    id          = $"edge-{conn.Id}",
                    source      = srcNodeId,
                    target      = dstNodeId,
                    label,
                    fromService = fromService ? "1" : "0"
                }
            });
        }

        return [.. elements];
    }

    private static string BuildEdgeLabel(int? port, string? protocol)
    {
        bool hasPort  = port.HasValue;
        bool hasProto = !string.IsNullOrWhiteSpace(protocol);
        if (hasPort && hasProto) return $"{port}/{protocol}";
        if (hasPort)             return $"{port}";
        if (hasProto)            return protocol!;
        return "";
    }

    /// <summary>
    /// Builds a Cytoscape node element for a server (compound / compartment node).
    /// Includes the SBGN data fields required by cytoscape-sbgn-stylesheet.
    /// </summary>
    private static object CreateServerElement(Server srv, bool dimmed)
    {
        string label = string.IsNullOrWhiteSpace(srv.IpAddress)
            ? srv.Name
            : $"{srv.Name}\n{srv.IpAddress}";

        return new
        {
            data = new
            {
                id                 = $"srv-{srv.Id}",
                label,
                type               = "server",
                @class             = "compartment",
                dimmed             = dimmed ? "1" : "0",
                stateVariables     = Array.Empty<object>(),
                unitsOfInformation = Array.Empty<object>(),
                clonemarker        = false
            }
        };
    }
}

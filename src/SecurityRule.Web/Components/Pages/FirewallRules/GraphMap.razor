@page "/connections/map"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@* Filter panel *@
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервер" Clearable="true"
                       Value="_filterServerId"
                       ValueChanged="@((int? v) => { _filterServerId = v; Recompute(); })">
                @foreach (var s in _allServers)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервис" Clearable="true"
                       Value="_filterServiceId"
                       ValueChanged="@((int? v) => { _filterServiceId = v; Recompute(); })">
                @foreach (var svc in _allServices)
                {
                    <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilters">Сбросить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!_filteredConnections.Any())
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudAlert Severity="Severity.Info" Class="mb-0">Нет связей для отображения</MudAlert>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="overflow: auto;" data-testid="connections-map-container">
        <svg width="@_svgWidth" height="@_svgHeight" xmlns="http://www.w3.org/2000/svg"
             data-testid="connections-graph" style="display: block; background: #ffffff;">
            <defs>
                @* Arrowhead for server → service connections (blue) *@
                <marker id="arr-srv" markerWidth="8" markerHeight="6"
                        refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#1565c0" />
                </marker>
                @* Arrowhead for service → service connections (purple) *@
                <marker id="arr-svc" markerWidth="8" markerHeight="6"
                        refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#6a1b9a" />
                </marker>
            </defs>

            @* ── Services cluster box ── *@
            @* Outer rounded rectangle *@
            <rect x="@SvcBoxX" y="@TopPad" width="@SvcBoxW" height="@_svcBoxH"
                  rx="10" fill="#fce4ec" stroke="#c62828" stroke-width="2" />
            @* Header background: rounded at top, flat at bottom (two-rect trick) *@
            <rect x="@SvcBoxX" y="@TopPad" width="@SvcBoxW" height="@SvcBoxHeaderH"
                  rx="10" fill="#c62828" />
            <rect x="@SvcBoxX" y="@(TopPad + SvcBoxHeaderH - 10)" width="@SvcBoxW" height="10"
                  fill="#c62828" />
            @* Header title *@
            @SvgText(SvcBoxX + SvcBoxW / 2, TopPad + SvcBoxHeaderH / 2 + 5, "middle", "white", 13, "bold", "⚙  СЕРВИСЫ")

            @* Individual service rows *@
            @foreach (var svc in _svcItems)
            {
                <rect x="@(SvcBoxX + SvcInnerPad)" y="@svc.Y"
                      width="@(SvcBoxW - 2 * SvcInnerPad)" height="@SvcRowH"
                      rx="5" fill="white" stroke="@svc.BorderColor" stroke-width="2" />
                <circle cx="@(SvcBoxX + SvcInnerPad + 14)" cy="@(svc.Y + SvcRowH / 2)"
                        r="5" fill="@svc.BorderColor" />
                @SvgText(SvcBoxX + SvcInnerPad + 27,
                         string.IsNullOrEmpty(svc.SubLabel) ? svc.Y + SvcRowH / 2 + 4 : svc.Y + SvcRowH / 2 - 3,
                         "start", "#212121", 12, "600", Truncate(svc.Name, 26))
                @if (!string.IsNullOrEmpty(svc.SubLabel))
                {
                    @SvgText(SvcBoxX + SvcInnerPad + 27, svc.Y + SvcRowH / 2 + 12,
                             "start", "#757575", 10, "normal", svc.SubLabel)
                }
            }

            @* ── Server nodes (left column) ── *@
            @foreach (var srv in _srvNodes)
            {
                @* Server box *@
                <rect x="@SrvColX" y="@srv.Y" width="@SrvNodeW" height="@SrvNodeH"
                      rx="6" fill="#e3f2fd" stroke="#1565c0" stroke-width="1.5" />
                @* Left accent stripe *@
                <rect x="@SrvColX" y="@srv.Y" width="5" height="@SrvNodeH"
                      rx="2" fill="#1565c0" />
                @* Server icon rectangle inside stripe area *@
                <rect x="@(SrvColX + 10)" y="@(srv.Y + SrvNodeH / 2 - 7)" width="12" height="9"
                      rx="1" fill="none" stroke="#1565c0" stroke-width="1.2" />
                <line x1="@(SrvColX + 10)" y1="@(srv.Y + SrvNodeH / 2 - 2)"
                      x2="@(SrvColX + 22)" y2="@(srv.Y + SrvNodeH / 2 - 2)"
                      stroke="#1565c0" stroke-width="1" />
                @* Label *@
                @SvgText(SrvColX + 28,
                         string.IsNullOrEmpty(srv.IpAddress) ? srv.Y + SrvNodeH / 2 + 4 : srv.Y + SrvNodeH / 2 - 3,
                         "start", "#0d47a1", 12, "600", Truncate(srv.Name, 18))
                @if (!string.IsNullOrEmpty(srv.IpAddress))
                {
                    @SvgText(SrvColX + 28, srv.Y + SrvNodeH / 2 + 12, "start", "#546e7a", 10, "normal", srv.IpAddress)
                }
            }

            @* ── Server → Service bezier arrows ── *@
            @foreach (var edge in _srvEdges)
            {
                int ex1  = SrvColX + SrvNodeW;
                int ey1  = edge.SrcY;
                int ex2  = SvcBoxX;
                int ey2  = edge.DstY;
                int cp1x = ex1 + (ex2 - ex1) * 2 / 3;
                int cp2x = ex1 + (ex2 - ex1) / 3;
                <path d="M @ex1 @ey1 C @cp1x @ey1 @cp2x @ey2 @ex2 @ey2"
                      fill="none" stroke="#1565c0" stroke-width="1.5"
                      marker-end="url(#arr-srv)" />
                @if (!string.IsNullOrWhiteSpace(edge.Protocol))
                {
                    int lx = ex1 + (ex2 - ex1) / 2;
                    int ly = ey1 + (ey2 - ey1) / 2;
                    <rect x="@(lx - 18)" y="@(ly - 9)" width="36" height="14"
                          rx="3" fill="white" stroke="#1565c0" stroke-width="0.5" opacity="0.9" />
                    @SvgText(lx, ly + 2, "middle", "#1565c0", 9, "normal", edge.Protocol)
                }
            }

            @* ── Service → Service loop arrows (exit right side of box) ── *@
            @foreach (var edge in _svcEdges)
            {
                int lx1   = SvcBoxX + SvcBoxW;
                int ly1   = edge.SrcY;
                int lx2   = SvcBoxX + SvcBoxW;
                int ly2   = edge.DstY;
                int loopX = lx1 + LoopXOffset;
                <path d="M @lx1 @ly1 C @loopX @ly1 @loopX @ly2 @lx2 @ly2"
                      fill="none" stroke="#6a1b9a" stroke-width="1.5"
                      marker-end="url(#arr-svc)" />
                @if (!string.IsNullOrWhiteSpace(edge.Protocol))
                {
                    int plx = loopX + 6;
                    int ply = (ly1 + ly2) / 2;
                    <rect x="@plx" y="@(ply - 8)" width="34" height="14"
                          rx="3" fill="white" stroke="#6a1b9a" stroke-width="0.5" opacity="0.9" />
                    @SvgText(plx + 17, ply + 2, "middle", "#6a1b9a", 9, "normal", edge.Protocol)
                }
            }
        </svg>
    </MudPaper>

    @* Legend *@
    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e3f2fd; border:1.5px solid #1565c0; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервер-источник</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#fce4ec; border:1.5px solid #c62828; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Группа сервисов</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:10px; height:10px; border-radius:50%; background:#2e7d32;"></div>
                <MudText Typo="Typo.caption">Только источник</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:10px; height:10px; border-radius:50%; background:#e65100;"></div>
                <MudText Typo="Typo.caption">Только получатель</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:10px; height:10px; border-radius:50%; background:#7b1fa2;"></div>
                <MudText Typo="Typo.caption">Источник и получатель</MudText>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    // ── Layout constants ─────────────────────────────────────────────────────
    private const int SrvColX       = 20;
    private const int SrvNodeW      = 185;
    private const int SrvNodeH      = 48;
    private const int SrvNodeGap    = 20;
    private const int ColGap        = 50;
    private const int SvcBoxX       = SrvColX + SrvNodeW + ColGap; // = 255
    private const int SvcBoxW       = 340;
    private const int SvcBoxHeaderH = 34;
    private const int SvcInnerPad   = 12;
    private const int SvcRowH       = 42;
    private const int SvcRowGap     = 8;
    private const int SvcBoxPadBot  = 14;
    private const int TopPad        = 20;
    private const int LoopXOffset   = 60;

    // ── Record types ─────────────────────────────────────────────────────────
    private sealed record SvcItem(string Id, string Name, string SubLabel, int Y, string BorderColor);
    private sealed record SrvNode(string Id, string Name, string IpAddress, int Y);
    private sealed record SrvEdge(int SrcY, int DstY, string Protocol);
    private sealed record SvcEdge(int SrcY, int DstY, string Protocol);

    // ── Dynamic SVG dimensions ───────────────────────────────────────────────
    private int _svcBoxH  = 120;
    private int _svgWidth  = 700;
    private int _svgHeight = 300;

    // ── State ────────────────────────────────────────────────────────────────
    private bool  _loading         = true;
    private int?  _filterServerId  = null;
    private int?  _filterServiceId = null;

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private List<ServiceConnection> _filteredConnections = [];
    private List<SvcItem>           _svcItems            = [];
    private List<SrvNode>           _srvNodes            = [];
    private List<SrvEdge>           _srvEdges            = [];
    private List<SvcEdge>           _svcEdges            = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _allConnections = await ServiceConnectionRepository.GetAllAsync();
        _allServers     = await ServerRepository.GetAllAsync();
        _allServices    = await AppServiceRepository.GetAllAsync();
        _loading = false;
        Recompute();
    }

    private void ClearFilters()
    {
        _filterServerId  = null;
        _filterServiceId = null;
        Recompute();
    }

    // ── Graph computation ────────────────────────────────────────────────────
    private void Recompute()
    {
        _filteredConnections = _allConnections.Where(c =>
        {
            if (_filterServerId.HasValue &&
                c.SourceServerId != _filterServerId &&
                c.DestinationServerId != _filterServerId)
                return false;

            if (_filterServiceId.HasValue &&
                c.SourceServiceId != _filterServiceId &&
                c.DestinationServiceId != _filterServiceId)
                return false;

            return true;
        }).ToList();

        // ── Collect all unique services (sources + destinations) ──────────
        var svcSrcIds = new HashSet<int>();
        var svcDstIds = new HashSet<int>();
        var svcInfos  = new Dictionary<int, (string Name, string Sub)>();

        foreach (var c in _filteredConnections)
        {
            svcDstIds.Add(c.DestinationServiceId);
            EnsureSvcInfo(svcInfos, c.DestinationServiceId, c.DestinationService);

            if (c.SourceServiceId.HasValue)
            {
                svcSrcIds.Add(c.SourceServiceId.Value);
                EnsureSvcInfo(svcInfos, c.SourceServiceId.Value, c.SourceService);
            }
        }

        // Sort: source-only first, then destination-only, by name
        var orderedSvcIds = svcInfos.Keys
            .OrderBy(id => svcSrcIds.Contains(id) ? 0 : 1)
            .ThenBy(id => svcInfos[id].Name)
            .ToList();

        int svcRowsStartY = TopPad + SvcBoxHeaderH + SvcRowGap;

        _svcItems = orderedSvcIds.Select((id, i) =>
        {
            bool isSrc = svcSrcIds.Contains(id);
            bool isDst = svcDstIds.Contains(id);
            string border = (isSrc && isDst) ? "#7b1fa2"
                          : isSrc            ? "#2e7d32"
                                             : "#e65100";
            return new SvcItem(
                $"svc-{id}",
                svcInfos[id].Name,
                svcInfos[id].Sub,
                svcRowsStartY + i * (SvcRowH + SvcRowGap),
                border);
        }).ToList();

        _svcBoxH = SvcBoxHeaderH + SvcRowGap
                 + orderedSvcIds.Count * (SvcRowH + SvcRowGap)
                 + SvcBoxPadBot;

        // ── Collect unique source servers ─────────────────────────────────
        var srvInfos = new Dictionary<int, (string Name, string Ip)>();
        foreach (var c in _filteredConnections.Where(c => c.SourceServerId.HasValue))
        {
            int id = c.SourceServerId!.Value;
            if (!srvInfos.ContainsKey(id))
                srvInfos[id] = (c.SourceServer?.Name ?? $"Сервер #{id}",
                                c.SourceServer?.IpAddress ?? "");
        }

        // Center servers vertically relative to services box
        int svcBoxCenterY = TopPad + _svcBoxH / 2;
        int srvCount      = srvInfos.Count;
        int srvTotalH     = srvCount * SrvNodeH + Math.Max(0, srvCount - 1) * SrvNodeGap;
        int srvStartY     = Math.Max(TopPad, svcBoxCenterY - srvTotalH / 2);

        _srvNodes = srvInfos.Keys
            .OrderBy(id => srvInfos[id].Name)
            .Select((id, i) => new SrvNode(
                $"srv-{id}",
                srvInfos[id].Name,
                srvInfos[id].Ip,
                srvStartY + i * (SrvNodeH + SrvNodeGap)))
            .ToList();

        // ── Server → Service edges ────────────────────────────────────────
        _srvEdges = _filteredConnections
            .Where(c => c.SourceServerId.HasValue)
            .Select(c =>
            {
                var srv = _srvNodes.FirstOrDefault(n => n.Id == $"srv-{c.SourceServerId}");
                var svc = _svcItems.FirstOrDefault(n => n.Id == $"svc-{c.DestinationServiceId}");
                int srcY = (srv?.Y ?? srvStartY) + SrvNodeH / 2;
                int dstY = (svc?.Y ?? svcRowsStartY) + SvcRowH / 2;
                return new SrvEdge(srcY, dstY, c.Protocol);
            }).ToList();

        // ── Service → Service edges (loop right) ──────────────────────────
        _svcEdges = _filteredConnections
            .Where(c => c.SourceServiceId.HasValue && !c.SourceServerId.HasValue)
            .Select(c =>
            {
                var src = _svcItems.FirstOrDefault(n => n.Id == $"svc-{c.SourceServiceId}");
                var dst = _svcItems.FirstOrDefault(n => n.Id == $"svc-{c.DestinationServiceId}");
                int srcY = (src?.Y ?? svcRowsStartY) + SvcRowH / 2;
                int dstY = (dst?.Y ?? svcRowsStartY) + SvcRowH / 2;
                return new SvcEdge(srcY, dstY, c.Protocol);
            }).ToList();

        // ── SVG dimensions ────────────────────────────────────────────────
        int svcColBottom = TopPad + _svcBoxH;
        int srvColBottom = srvCount > 0
            ? srvStartY + srvCount * SrvNodeH + (srvCount - 1) * SrvNodeGap
            : 0;
        _svgHeight = Math.Max(svcColBottom, srvColBottom) + 30;

        bool hasLoops = _svcEdges.Any();
        _svgWidth = SvcBoxX + SvcBoxW + (hasLoops ? LoopXOffset + 50 : 24) + 10;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private static void EnsureSvcInfo(Dictionary<int, (string Name, string Sub)> dict,
                                      int id, AppService? svc)
    {
        if (!dict.ContainsKey(id))
            dict[id] = (svc?.Name ?? $"Сервис #{id}",
                        svc?.Port.HasValue == true ? $":{svc.Port}" : "");
    }

    private static string Truncate(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..maxLen] + "…";

    private static MarkupString SvgText(int x, int y, string anchor, string fill,
                                        int fontSize, string fontWeight, string content)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        return (MarkupString)(
            $"<text x=\"{x}\" y=\"{y}\" text-anchor=\"{anchor}\" fill=\"{fill}\" " +
            $"font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" " +
            $"font-family=\"Roboto, sans-serif\">{encoded}</text>");
    }
}

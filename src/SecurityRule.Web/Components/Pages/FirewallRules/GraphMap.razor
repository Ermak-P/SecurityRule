@page "/connections/map"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@* Filter panel *@
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервер" Clearable="true"
                       Value="_filterServerId"
                       ValueChanged="@((int? v) => { _filterServerId = v; Recompute(); })">
                @foreach (var s in _allServers)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервис" Clearable="true"
                       Value="_filterServiceId"
                       ValueChanged="@((int? v) => { _filterServiceId = v; Recompute(); })">
                @foreach (var svc in _allServices)
                {
                    <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilters">Сбросить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!_filteredConnections.Any())
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudAlert Severity="Severity.Info" Class="mb-0">Нет связей для отображения</MudAlert>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="overflow: auto;" data-testid="connections-map-container">
        <svg width="@_svgWidth" height="@_svgHeight" xmlns="http://www.w3.org/2000/svg"
             data-testid="connections-graph" style="display: block;">
            <defs>
                <marker id="arrowhead" markerWidth="8" markerHeight="6"
                        refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#9e9e9e" />
                </marker>
            </defs>

            @* Column background panels *@
            <rect x="@(_srcColX - 10)" y="42"
                  width="@(_nodeWidth + 20)" height="@(_svgHeight - 52)"
                  rx="8" fill="#fafafa" stroke="#e0e0e0" stroke-width="1" />
            <rect x="@(_dstColX - 10)" y="42"
                  width="@(_nodeWidth + 20)" height="@(_svgHeight - 52)"
                  rx="8" fill="#fafafa" stroke="#e0e0e0" stroke-width="1" />

            @* Column headers *@
            <text x="@(_srcColX + _nodeWidth / 2)" y="32"
                  text-anchor="middle" font-weight="bold" fill="#616161"
                  font-size="13" font-family="Roboto, sans-serif">Источник</text>
            <text x="@(_dstColX + _nodeWidth / 2)" y="32"
                  text-anchor="middle" font-weight="bold" fill="#616161"
                  font-size="13" font-family="Roboto, sans-serif">Назначение</text>

            @* Edges (drawn first so nodes appear on top) *@
            @foreach (var edge in _edges)
            {
                int midX = (_srcColX + _nodeWidth + _dstColX) / 2;
                int midY = (edge.SrcMidY + edge.DstMidY) / 2;
                <line x1="@(_srcColX + _nodeWidth)" y1="@edge.SrcMidY"
                      x2="@_dstColX" y2="@edge.DstMidY"
                      stroke="#bdbdbd" stroke-width="1.5"
                      marker-end="url(#arrowhead)" />
                @if (!string.IsNullOrWhiteSpace(edge.Protocol))
                {
                    @SvgText(midX, midY - 5, "middle", "#bdbdbd", 10, "normal", edge.Protocol)
                }
            }

            @* Source nodes *@
            @foreach (var node in _srcNodes)
            {
                string fill   = node.IsServer ? "#e3f2fd" : "#e8f5e9";
                string stroke = node.IsServer ? "#90caf9" : "#a5d6a7";
                int labelY    = string.IsNullOrEmpty(node.SubLabel)
                                    ? node.Y + _nodeHeight / 2 + 4
                                    : node.Y + _nodeHeight / 2 - 4;
                <g data-node-id="@node.Id">
                    <rect x="@_srcColX" y="@node.Y"
                          width="@_nodeWidth" height="@_nodeHeight"
                          rx="5" fill="@fill" stroke="@stroke" stroke-width="1.5" />
                    @SvgText(_srcColX + _nodeWidth / 2, labelY, "middle", "#212121", 12, "500", Truncate(node.Label, 22))
                    @if (!string.IsNullOrEmpty(node.SubLabel))
                    {
                        @SvgText(_srcColX + _nodeWidth / 2, node.Y + _nodeHeight / 2 + 11, "middle", "#757575", 10, "normal", node.SubLabel)
                    }
                </g>
            }

            @* Destination nodes *@
            @foreach (var node in _dstNodes)
            {
                string fill   = node.IsServer ? "#e3f2fd" : "#fff3e0";
                string stroke = node.IsServer ? "#90caf9" : "#ffcc80";
                int labelY    = string.IsNullOrEmpty(node.SubLabel)
                                    ? node.Y + _nodeHeight / 2 + 4
                                    : node.Y + _nodeHeight / 2 - 4;
                <g data-node-id="@node.Id">
                    <rect x="@_dstColX" y="@node.Y"
                          width="@_nodeWidth" height="@_nodeHeight"
                          rx="5" fill="@fill" stroke="@stroke" stroke-width="1.5" />
                    @SvgText(_dstColX + _nodeWidth / 2, labelY, "middle", "#212121", 12, "500", Truncate(node.Label, 22))
                    @if (!string.IsNullOrEmpty(node.SubLabel))
                    {
                        @SvgText(_dstColX + _nodeWidth / 2, node.Y + _nodeHeight / 2 + 11, "middle", "#757575", 10, "normal", node.SubLabel)
                    }
                </g>
            }
        </svg>
    </MudPaper>

    @* Legend *@
    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e3f2fd; border:1.5px solid #90caf9; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервер</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e8f5e9; border:1.5px solid #a5d6a7; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервис (источник)</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#fff3e0; border:1.5px solid #ffcc80; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервис (назначение)</MudText>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    private sealed record GraphNode(string Id, string Label, string SubLabel, bool IsServer, int Y);
    private sealed record GraphEdge(int SrcMidY, int DstMidY, string Protocol);

    private const int NodeWidth  = 200;
    private const int NodeHeight = 44;
    private const int NodeGap    = 22;
    private const int TopPadding = 58;
    private const int ColPadding = 30;
    private const int SvgTotalWidth = 820;

    private readonly int _nodeWidth  = NodeWidth;
    private readonly int _nodeHeight = NodeHeight;
    private readonly int _srcColX    = ColPadding;
    private readonly int _dstColX    = SvgTotalWidth - NodeWidth - ColPadding;
    private readonly int _svgWidth   = SvgTotalWidth;

    private int _svgHeight = 200;

    private bool   _loading         = true;
    private int?   _filterServerId  = null;
    private int?   _filterServiceId = null;

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private List<ServiceConnection> _filteredConnections = [];
    private List<GraphNode>         _srcNodes            = [];
    private List<GraphNode>         _dstNodes            = [];
    private List<GraphEdge>         _edges               = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _allConnections = await ServiceConnectionRepository.GetAllAsync();
        _allServers     = await ServerRepository.GetAllAsync();
        _allServices    = await AppServiceRepository.GetAllAsync();
        _loading = false;
        Recompute();
    }

    private void ClearFilters()
    {
        _filterServerId  = null;
        _filterServiceId = null;
        Recompute();
    }

    private void Recompute()
    {
        _filteredConnections = _allConnections.Where(c =>
        {
            if (_filterServerId.HasValue &&
                c.SourceServerId != _filterServerId &&
                c.DestinationServerId != _filterServerId)
                return false;

            if (_filterServiceId.HasValue &&
                c.SourceServiceId != _filterServiceId &&
                c.DestinationServiceId != _filterServiceId)
                return false;

            return true;
        }).ToList();

        var srcList  = new List<(string Key, string Label, string SubLabel, bool IsServer)>();
        var dstList  = new List<(string Key, string Label, string SubLabel, bool IsServer)>();
        var srcSeen  = new HashSet<string>();
        var dstSeen  = new HashSet<string>();

        foreach (var c in _filteredConnections)
        {
            // Source node
            string srcKey;
            string srcLabel, srcSubLabel;
            bool   srcIsServer;

            if (c.SourceServerId.HasValue)
            {
                srcKey      = $"srv-{c.SourceServerId}";
                srcLabel    = c.SourceServer?.Name ?? $"Сервер #{c.SourceServerId}";
                srcSubLabel = c.SourceServer?.IpAddress ?? "";
                srcIsServer = true;
            }
            else if (c.SourceServiceId.HasValue)
            {
                srcKey      = $"svc-{c.SourceServiceId}";
                srcLabel    = c.SourceService?.Name ?? $"Сервис #{c.SourceServiceId}";
                srcSubLabel = c.SourceService?.Port.HasValue == true
                                  ? $":{c.SourceService.Port}"
                                  : "";
                srcIsServer = false;
            }
            else
            {
                srcKey      = "anon";
                srcLabel    = "—";
                srcSubLabel = "";
                srcIsServer = false;
            }

            if (srcSeen.Add(srcKey))
                srcList.Add((srcKey, srcLabel, srcSubLabel, srcIsServer));

            // Destination node (always a service)
            string dstKey      = $"dst-svc-{c.DestinationServiceId}";
            string dstLabel    = c.DestinationService?.Name ?? $"Сервис #{c.DestinationServiceId}";
            string dstSubLabel = c.DestinationService?.Port.HasValue == true
                                     ? $":{c.DestinationService.Port}"
                                     : "";

            if (dstSeen.Add(dstKey))
                dstList.Add((dstKey, dstLabel, dstSubLabel, false));
        }

        int spacing = NodeHeight + NodeGap;

        _srcNodes = srcList
            .Select((t, i) => new GraphNode(t.Key, t.Label, t.SubLabel, t.IsServer,
                                            TopPadding + i * spacing))
            .ToList();

        _dstNodes = dstList
            .Select((t, i) => new GraphNode(t.Key, t.Label, t.SubLabel, t.IsServer,
                                            TopPadding + i * spacing))
            .ToList();

        _edges = _filteredConnections.Select(c =>
        {
            string srcKey = c.SourceServerId.HasValue  ? $"srv-{c.SourceServerId}"
                          : c.SourceServiceId.HasValue ? $"svc-{c.SourceServiceId}"
                          : "anon";
            string dstKey = $"dst-svc-{c.DestinationServiceId}";

            var src = _srcNodes.FirstOrDefault(n => n.Id == srcKey);
            var dst = _dstNodes.FirstOrDefault(n => n.Id == dstKey);

            int srcMidY = (src?.Y ?? TopPadding) + NodeHeight / 2;
            int dstMidY = (dst?.Y ?? TopPadding) + NodeHeight / 2;

            return new GraphEdge(srcMidY, dstMidY, c.Protocol);
        }).ToList();

        int maxNodes = Math.Max(1, Math.Max(_srcNodes.Count, _dstNodes.Count));
        _svgHeight = TopPadding + maxNodes * spacing + NodeGap + 10;
    }

    private static string Truncate(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..maxLen] + "…";

    private static MarkupString SvgText(int x, int y, string anchor, string fill, int fontSize, string fontWeight, string content)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        return (MarkupString)$"<text x=\"{x}\" y=\"{y}\" text-anchor=\"{anchor}\" fill=\"{fill}\" font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" font-family=\"Roboto, sans-serif\">{encoded}</text>";
    }
}

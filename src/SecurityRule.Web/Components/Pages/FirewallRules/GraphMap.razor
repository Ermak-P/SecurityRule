@page "/connections/map"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@* Filter panel *@
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервер" Clearable="true"
                       Value="_filterServerId"
                       ValueChanged="@((int? v) => { _filterServerId = v; Recompute(); })">
                @foreach (var s in _allServers)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервис" Clearable="true"
                       Value="_filterServiceId"
                       ValueChanged="@((int? v) => { _filterServiceId = v; Recompute(); })">
                @foreach (var svc in _allServices)
                {
                    <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilters">Сбросить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!_filteredConnections.Any())
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudAlert Severity="Severity.Info" Class="mb-0">Нет связей для отображения</MudAlert>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="overflow: auto;" data-testid="connections-map-container">
        <svg width="@_svgWidth" height="@_svgHeight" xmlns="http://www.w3.org/2000/svg"
             data-testid="connections-graph" style="display: block; background: #fafafa;">
            <defs>
                @* Arrowhead – server source (blue) *@
                <marker id="arr-srv" markerWidth="8" markerHeight="6"
                        refX="1" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="@SrvStroke" />
                </marker>
                @* Arrowhead – service source (teal) *@
                <marker id="arr-svc" markerWidth="8" markerHeight="6"
                        refX="1" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="@SvcArrowStroke" />
                </marker>
            </defs>

            @* ── Server clusters (single column – each server/service appears exactly once) ── *@
            @foreach (var cl in _clusters)
            {
                @* Outer body *@
                <rect x="@ColX" y="@cl.Y" width="@ClusterW" height="@cl.Height"
                      rx="8" fill="@SrvFill" stroke="@SrvStroke" stroke-width="1.5" />
                @* Header fill (rounded top, flat bottom) *@
                <rect x="@ColX" y="@cl.Y" width="@ClusterW" height="@ClusterHeaderH"
                      rx="8" fill="@SrvStroke" />
                <rect x="@ColX" y="@(cl.Y + ClusterHeaderH - 8)" width="@ClusterW" height="8"
                      fill="@SrvStroke" />
                @* Server icon *@
                <rect x="@(ColX + 10)" y="@(cl.Y + ClusterHeaderH / 2 - 7)" width="13" height="9"
                      rx="1" fill="none" stroke="white" stroke-width="1.2" />
                <line x1="@(ColX + 10)" y1="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      x2="@(ColX + 23)" y2="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      stroke="white" stroke-width="1" />
                @* Name + IP *@
                @if (!string.IsNullOrEmpty(cl.IpAddress))
                {
                    @SvgText(ColX + 32, cl.Y + ClusterHeaderH / 2 - 3, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                    @SvgText(ColX + 32, cl.Y + ClusterHeaderH / 2 + 11, "start", "#bbdefb", 9, "normal", cl.IpAddress)
                }
                else
                {
                    @SvgText(ColX + 32, cl.Y + ClusterHeaderH / 2 + 4, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                }
                @* Service rows – extend to cluster right edge so arrows exit from the service *@
                @foreach (var svc in cl.Services)
                {
                    <rect x="@(ColX + SvcInnerPad)" y="@svc.Y"
                          width="@(ClusterW - SvcInnerPad)" height="@SvcRowH"
                          rx="4" fill="white" stroke="#64b5f6" stroke-width="1.2" />
                    <circle cx="@(ColX + SvcInnerPad + 10)" cy="@(svc.Y + SvcRowH / 2)"
                            r="4" fill="#1e88e5" />
                    @SvgText(ColX + SvcInnerPad + 20, svc.Y + SvcRowH / 2 + 4,
                             "start", "#1a237e", 11, "500", Truncate(svc.Name, 21))
                }
            }

            @* ── Arrows (bezier arcs to the right of the cluster column) ── *@
            @foreach (var edge in _edges)
            {
                int x1 = edge.SrcX;
                int y1 = edge.SrcY;
                int x2 = edge.DstX;
                int y2 = edge.DstY;
                int ax = edge.ArcX;
                string stroke = edge.IsFromService ? SvcArrowStroke : SrvStroke;
                string marker = edge.IsFromService ? "url(#arr-svc)" : "url(#arr-srv)";
                @* Cubic bezier: exits source on the right, arcs through ArcX, enters destination from the right *@
                <path d="M @x1 @y1 C @ax @y1 @ax @y2 @x2 @y2"
                      fill="none" stroke="@stroke" stroke-width="1.5"
                      marker-end="@marker" />
                @if (!string.IsNullOrEmpty(edge.Label))
                {
                    int lx   = ax;
                    int ly   = (y1 + y2) / 2;
                    int lblW = edge.Label.Length * 6 + 10;
                    <rect x="@(lx - lblW / 2)" y="@(ly - 9)" width="@lblW" height="14"
                          rx="3" fill="white" stroke="@stroke" stroke-width="0.6" opacity="0.95" />
                    @SvgText(lx, ly + 2, "middle", stroke, 9, "600", edge.Label)
                }
            }
        </svg>
    </MudPaper>

    @* Legend *@
    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e3f2fd; border:1.5px solid #1565c0; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервер</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <marker id="leg-srv" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                            <polygon points="0 0, 6 2.5, 0 5" fill="#1565c0" />
                        </marker>
                    </defs>
                    <line x1="0" y1="6" x2="22" y2="6" stroke="#1565c0" stroke-width="1.5" marker-end="url(#leg-srv)" />
                </svg>
                <MudText Typo="Typo.caption">Связь от сервера</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <marker id="leg-svc" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                            <polygon points="0 0, 6 2.5, 0 5" fill="#00695c" />
                        </marker>
                    </defs>
                    <line x1="0" y1="6" x2="22" y2="6" stroke="#00695c" stroke-width="1.5" marker-end="url(#leg-svc)" />
                </svg>
                <MudText Typo="Typo.caption">Связь от сервиса</MudText>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    // ── Layout constants ─────────────────────────────────────────────────────
    private const int ColX           = 20;   // left edge of the single cluster column
    private const int ClusterW       = 215;
    private const int ClusterHeaderH = 40;
    private const int SvcRowH        = 36;
    private const int SvcRowGap      = 6;
    private const int SvcInnerPad    = 10;
    private const int ClusterPadTop  = 8;
    private const int ClusterPadBot  = 10;
    private const int ClusterGapV    = 16;
    private const int TopPad         = 20;
    private const int ArcGap         = 14;   // gap between cluster right edge and first arc lane
    private const int ArcStep        = 22;   // X increment per arc lane to avoid overlap

    // Connection point X – right edge of cluster (both service rows and server header exit here)
    private static int ConnX    => ColX + ClusterW;
    private static int ArcBaseX => ColX + ClusterW + ArcGap;

    // ── Color constants ───────────────────────────────────────────────────────
    private const string SrvStroke      = "#1565c0";
    private const string SrvFill        = "#e3f2fd";
    private const string SvcArrowStroke = "#00695c";

    // ── Record types ─────────────────────────────────────────────────────────
    private sealed record ClusterSvcItem(int ServiceId, string Name, int Y);
    private sealed record ClusterNode(int ServerId, string Name, string IpAddress, int Y, int Height, List<ClusterSvcItem> Services);
    private sealed record MapEdge(bool IsFromService, int SrcX, int SrcY, int DstX, int DstY, string Label, int ArcX);

    // ── Dynamic SVG dimensions ────────────────────────────────────────────────
    private int _svgWidth  = 400;
    private int _svgHeight = 300;

    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loading         = true;
    private int? _filterServerId  = null;
    private int? _filterServiceId = null;

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private List<ServiceConnection> _filteredConnections = [];
    private List<ClusterNode>       _clusters            = [];
    private List<MapEdge>           _edges               = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _allConnections = await ServiceConnectionRepository.GetAllAsync();
        _allServers     = await ServerRepository.GetAllAsync();
        _allServices    = await AppServiceRepository.GetAllAsync();
        _loading = false;
        Recompute();
    }

    private void ClearFilters()
    {
        _filterServerId  = null;
        _filterServiceId = null;
        Recompute();
    }

    // ── Graph computation ─────────────────────────────────────────────────────
    private void Recompute()
    {
        _filteredConnections = _allConnections.Where(c =>
        {
            if (_filterServerId.HasValue &&
                c.SourceServerId != _filterServerId &&
                c.DestinationServerId != _filterServerId)
                return false;

            if (_filterServiceId.HasValue &&
                c.SourceServiceId != _filterServiceId &&
                c.DestinationServiceId != _filterServiceId)
                return false;

            return true;
        }).ToList();

        if (!_filteredConnections.Any())
        {
            _clusters = [];
            _edges    = [];
            return;
        }

        // ── Collect all unique (serverId → serviceIds) from both source and destination sides ──
        var serverServices = new Dictionary<int, HashSet<int>>();

        foreach (var c in _filteredConnections)
        {
            if (c.SourceServerId.HasValue)
            {
                if (!serverServices.ContainsKey(c.SourceServerId.Value))
                    serverServices[c.SourceServerId.Value] = [];
                if (c.SourceServiceId.HasValue)
                    serverServices[c.SourceServerId.Value].Add(c.SourceServiceId.Value);
            }

            if (c.DestinationServerId.HasValue)
            {
                if (!serverServices.ContainsKey(c.DestinationServerId.Value))
                    serverServices[c.DestinationServerId.Value] = [];
                serverServices[c.DestinationServerId.Value].Add(c.DestinationServiceId);
            }
        }

        // ── Build single cluster list ─────────────────────────────────────────
        _clusters = BuildClusters(serverServices);

        // ── Build edges ───────────────────────────────────────────────────────
        var edges    = new List<MapEdge>();
        int arcIndex = 0;

        foreach (var c in _filteredConnections)
        {
            if (!c.SourceServerId.HasValue) continue;

            var srcCluster = _clusters.FirstOrDefault(x => x.ServerId == c.SourceServerId.Value);
            if (srcCluster is null) continue;

            bool isFromService = c.SourceServiceId.HasValue;
            int srcX = ConnX;
            int srcY;

            if (isFromService)
            {
                var svc = srcCluster.Services.FirstOrDefault(s => s.ServiceId == c.SourceServiceId!.Value);
                srcY = svc is not null ? svc.Y + SvcRowH / 2 : srcCluster.Y + ClusterHeaderH / 2;
            }
            else
            {
                srcY = srcCluster.Y + ClusterHeaderH / 2;
            }

            if (!c.DestinationServerId.HasValue) continue;

            var dstCluster = _clusters.FirstOrDefault(x => x.ServerId == c.DestinationServerId.Value);
            if (dstCluster is null) continue;

            int dstX = ConnX;
            var dstSvc = dstCluster.Services.FirstOrDefault(s => s.ServiceId == c.DestinationServiceId);
            int dstY = dstSvc is not null ? dstSvc.Y + SvcRowH / 2 : dstCluster.Y + ClusterHeaderH / 2;

            string label = BuildEdgeLabel(
                c.DestinationService?.Port
                    ?? _allServices.FirstOrDefault(s => s.Id == c.DestinationServiceId)?.Port,
                c.Protocol);

            int arcX = ArcBaseX + arcIndex * ArcStep;
            edges.Add(new MapEdge(isFromService, srcX, srcY, dstX, dstY, label, arcX));
            arcIndex++;
        }

        _edges = edges;

        // ── SVG dimensions ────────────────────────────────────────────────────
        int clusterBottom = _clusters.Any() ? _clusters.Max(c => c.Y + c.Height) : TopPad;
        int maxArcX       = edges.Any() ? edges.Max(e => e.ArcX) + 30 : ArcBaseX + 30;
        _svgHeight = clusterBottom + 30;
        _svgWidth  = Math.Max(maxArcX, ColX + ClusterW + 40);
    }

    // ── Cluster builder ───────────────────────────────────────────────────────
    private List<ClusterNode> BuildClusters(Dictionary<int, HashSet<int>> serverServices)
    {
        var result = new List<ClusterNode>();
        int y = TopPad;

        foreach (var (srvId, rawSvcIds) in serverServices
            .OrderBy(kv => _allServers.FirstOrDefault(s => s.Id == kv.Key)?.Name ?? "Z"))
        {
            var srv     = _allServers.FirstOrDefault(s => s.Id == srvId);
            string name = srv?.Name ?? $"Сервер #{srvId}";
            string ip   = srv?.IpAddress ?? "";

            var svcIds = rawSvcIds
                .OrderBy(id => _allServices.FirstOrDefault(s => s.Id == id)?.Name ?? "")
                .ToList();

            int svcAreaH = svcIds.Count > 0
                ? ClusterPadTop + svcIds.Count * (SvcRowH + SvcRowGap) - SvcRowGap + ClusterPadBot
                : ClusterPadBot;
            int clusterH = ClusterHeaderH + svcAreaH;

            int svcY0    = y + ClusterHeaderH + ClusterPadTop;
            var svcItems = svcIds
                .Select((id, i) => new ClusterSvcItem(
                    id,
                    _allServices.FirstOrDefault(s => s.Id == id)?.Name ?? $"Сервис #{id}",
                    svcY0 + i * (SvcRowH + SvcRowGap)))
                .ToList();

            result.Add(new ClusterNode(srvId, name, ip, y, clusterH, svcItems));
            y += clusterH + ClusterGapV;
        }

        return result;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string BuildEdgeLabel(int? port, string? protocol)
    {
        bool hasPort  = port.HasValue;
        bool hasProto = !string.IsNullOrWhiteSpace(protocol);
        if (hasPort && hasProto) return $"{port}/{protocol}";
        if (hasPort)             return $"{port}";
        if (hasProto)            return protocol!;
        return "";
    }

    private static string Truncate(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..maxLen] + "…";

    private static MarkupString SvgText(int x, int y, string anchor, string fill,
                                        int fontSize, string fontWeight, string content)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        return (MarkupString)(
            $"<text x=\"{x}\" y=\"{y}\" text-anchor=\"{anchor}\" fill=\"{fill}\" " +
            $"font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" " +
            $"font-family=\"Roboto, sans-serif\">{encoded}</text>");
    }
}

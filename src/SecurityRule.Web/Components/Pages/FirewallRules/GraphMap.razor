@page "/connections/map"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@* Filter panel *@
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервер" Clearable="true"
                       Value="_filterServerId"
                       ValueChanged="@((int? v) => { _filterServerId = v; Recompute(); })">
                @foreach (var s in _allServers)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" Label="Сервис" Clearable="true"
                       Value="_filterServiceId"
                       ValueChanged="@((int? v) => { _filterServiceId = v; Recompute(); })">
                @foreach (var svc in _allServices)
                {
                    <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilters">Сбросить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!_filteredConnections.Any())
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudAlert Severity="Severity.Info" Class="mb-0">Нет связей для отображения</MudAlert>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="overflow: auto;" data-testid="connections-map-container">
        <svg width="@_svgWidth" height="@_svgHeight" xmlns="http://www.w3.org/2000/svg"
             data-testid="connections-graph" style="display: block; background: #fafafa;">
            <defs>
                @* Arrowhead – server source (blue) *@
                <marker id="arr-srv" markerWidth="8" markerHeight="6"
                        refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="@SrvStroke" />
                </marker>
                @* Arrowhead – service source (teal) *@
                <marker id="arr-svc" markerWidth="8" markerHeight="6"
                        refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="@SvcArrowStroke" />
                </marker>
            </defs>

            @* ── Left clusters: source servers ── *@
            @foreach (var cl in _leftClusters)
            {
                @* Outer body *@
                <rect x="@LeftColX" y="@cl.Y" width="@ClusterW" height="@cl.Height"
                      rx="8" fill="@SrvFill" stroke="@SrvStroke" stroke-width="1.5" />
                @* Header fill (rounded top, flat bottom) *@
                <rect x="@LeftColX" y="@cl.Y" width="@ClusterW" height="@ClusterHeaderH"
                      rx="8" fill="@SrvStroke" />
                <rect x="@LeftColX" y="@(cl.Y + ClusterHeaderH - 8)" width="@ClusterW" height="8"
                      fill="@SrvStroke" />
                @* Server icon *@
                <rect x="@(LeftColX + 10)" y="@(cl.Y + ClusterHeaderH / 2 - 7)" width="13" height="9"
                      rx="1" fill="none" stroke="white" stroke-width="1.2" />
                <line x1="@(LeftColX + 10)" y1="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      x2="@(LeftColX + 23)" y2="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      stroke="white" stroke-width="1" />
                @* Name + IP *@
                @if (!string.IsNullOrEmpty(cl.IpAddress))
                {
                    @SvgText(LeftColX + 32, cl.Y + ClusterHeaderH / 2 - 3, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                    @SvgText(LeftColX + 32, cl.Y + ClusterHeaderH / 2 + 11, "start", "#bbdefb", 9, "normal", cl.IpAddress)
                }
                else
                {
                    @SvgText(LeftColX + 32, cl.Y + ClusterHeaderH / 2 + 4, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                }
                @* Service rows *@
                @foreach (var svc in cl.Services)
                {
                    <rect x="@(LeftColX + SvcInnerPad)" y="@svc.Y"
                          width="@(ClusterW - 2 * SvcInnerPad)" height="@SvcRowH"
                          rx="4" fill="white" stroke="#64b5f6" stroke-width="1.2" />
                    <circle cx="@(LeftColX + SvcInnerPad + 10)" cy="@(svc.Y + SvcRowH / 2)"
                            r="4" fill="#1e88e5" />
                    @SvgText(LeftColX + SvcInnerPad + 20, svc.Y + SvcRowH / 2 + 4,
                             "start", "#1a237e", 11, "500", Truncate(svc.Name, 21))
                }
            }

            @* ── Right clusters: destination servers ── *@
            @foreach (var cl in _rightClusters)
            {
                @* Outer body *@
                <rect x="@RightColX" y="@cl.Y" width="@ClusterW" height="@cl.Height"
                      rx="8" fill="@DstFill" stroke="@DstStroke" stroke-width="1.5" />
                @* Header fill *@
                <rect x="@RightColX" y="@cl.Y" width="@ClusterW" height="@ClusterHeaderH"
                      rx="8" fill="@DstStroke" />
                <rect x="@RightColX" y="@(cl.Y + ClusterHeaderH - 8)" width="@ClusterW" height="8"
                      fill="@DstStroke" />
                @* Server icon *@
                <rect x="@(RightColX + 10)" y="@(cl.Y + ClusterHeaderH / 2 - 7)" width="13" height="9"
                      rx="1" fill="none" stroke="white" stroke-width="1.2" />
                <line x1="@(RightColX + 10)" y1="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      x2="@(RightColX + 23)" y2="@(cl.Y + ClusterHeaderH / 2 - 2)"
                      stroke="white" stroke-width="1" />
                @* Name + IP *@
                @if (!string.IsNullOrEmpty(cl.IpAddress))
                {
                    @SvgText(RightColX + 32, cl.Y + ClusterHeaderH / 2 - 3, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                    @SvgText(RightColX + 32, cl.Y + ClusterHeaderH / 2 + 11, "start", "#c8e6c9", 9, "normal", cl.IpAddress)
                }
                else
                {
                    @SvgText(RightColX + 32, cl.Y + ClusterHeaderH / 2 + 4, "start", "white", 11, "bold", Truncate(cl.Name, 22))
                }
                @* Service rows *@
                @foreach (var svc in cl.Services)
                {
                    <rect x="@(RightColX + SvcInnerPad)" y="@svc.Y"
                          width="@(ClusterW - 2 * SvcInnerPad)" height="@SvcRowH"
                          rx="4" fill="white" stroke="#81c784" stroke-width="1.2" />
                    <circle cx="@(RightColX + SvcInnerPad + 10)" cy="@(svc.Y + SvcRowH / 2)"
                            r="4" fill="#43a047" />
                    @SvgText(RightColX + SvcInnerPad + 20, svc.Y + SvcRowH / 2 + 4,
                             "start", "#1b5e20", 11, "500", Truncate(svc.Name, 21))
                }
            }

            @* ── Arrows ── *@
            @foreach (var edge in _edges)
            {
                int x1   = LeftColX + ClusterW;
                int y1   = edge.SrcY;
                int x2   = RightColX;
                int y2   = edge.DstY;
                int cp1x = x1 + (x2 - x1) / 3;
                int cp2x = x1 + 2 * (x2 - x1) / 3;
                string stroke = edge.IsFromService ? SvcArrowStroke : SrvStroke;
                string marker = edge.IsFromService ? "url(#arr-svc)" : "url(#arr-srv)";
                <path d="M @x1 @y1 C @cp1x @y1 @cp2x @y2 @x2 @y2"
                      fill="none" stroke="@stroke" stroke-width="1.5"
                      marker-end="@marker" />
                @if (!string.IsNullOrEmpty(edge.Label))
                {
                    int lx   = (x1 + x2) / 2;
                    int ly   = (y1 + y2) / 2;
                    int lblW = edge.Label.Length * 6 + 10;
                    <rect x="@(lx - lblW / 2)" y="@(ly - 9)" width="@lblW" height="14"
                          rx="3" fill="white" stroke="@stroke" stroke-width="0.6" opacity="0.95" />
                    @SvgText(lx, ly + 2, "middle", stroke, 9, "600", edge.Label)
                }
            }
        </svg>
    </MudPaper>

    @* Legend *@
    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e3f2fd; border:1.5px solid #1565c0; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервер-источник</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <div style="width:18px; height:12px; background:#e8f5e9; border:1.5px solid #2e7d32; border-radius:3px;"></div>
                <MudText Typo="Typo.caption">Сервер-получатель</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <marker id="leg-srv" markerWidth="6" markerHeight="5" refX="5" refY="2.5" orient="auto">
                            <polygon points="0 0, 6 2.5, 0 5" fill="#1565c0" />
                        </marker>
                    </defs>
                    <line x1="0" y1="6" x2="22" y2="6" stroke="#1565c0" stroke-width="1.5" marker-end="url(#leg-srv)" />
                </svg>
                <MudText Typo="Typo.caption">Связь от сервера</MudText>
            </div>
            <div style="display:inline-flex; align-items:center; gap:6px;">
                <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <marker id="leg-svc" markerWidth="6" markerHeight="5" refX="5" refY="2.5" orient="auto">
                            <polygon points="0 0, 6 2.5, 0 5" fill="#00695c" />
                        </marker>
                    </defs>
                    <line x1="0" y1="6" x2="22" y2="6" stroke="#00695c" stroke-width="1.5" marker-end="url(#leg-svc)" />
                </svg>
                <MudText Typo="Typo.caption">Связь от сервиса</MudText>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    // ── Layout constants ─────────────────────────────────────────────────────
    private const int LeftColX       = 20;
    private const int ClusterW       = 215;
    private const int ColGap         = 90;
    private const int RightColX      = LeftColX + ClusterW + ColGap;  // = 325
    private const int ClusterHeaderH = 40;
    private const int SvcRowH        = 36;
    private const int SvcRowGap      = 6;
    private const int SvcInnerPad    = 10;
    private const int ClusterPadTop  = 8;
    private const int ClusterPadBot  = 10;
    private const int ClusterGapV    = 16;
    private const int TopPad         = 20;

    // ── Color constants ───────────────────────────────────────────────────────
    private const string SrvStroke      = "#1565c0";  // source server cluster border + arrows
    private const string SrvFill        = "#e3f2fd";  // source server cluster body fill
    private const string DstStroke      = "#2e7d32";  // destination server cluster border + arrows
    private const string DstFill        = "#e8f5e9";  // destination server cluster body fill
    private const string SvcArrowStroke = "#00695c";  // service-sourced arrow colour

    // ── Record types ─────────────────────────────────────────────────────────
    private sealed record ClusterSvcItem(int ServiceId, string Name, int Y);
    private sealed record ClusterNode(string Id, string Name, string IpAddress, int Y, int Height, List<ClusterSvcItem> Services);
    private sealed record MapEdge(bool IsFromService, int SrcY, int DstY, string Label);

    // ── Dynamic SVG dimensions ────────────────────────────────────────────────
    private int _svgWidth  = 650;
    private int _svgHeight = 300;

    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loading        = true;
    private int? _filterServerId  = null;
    private int? _filterServiceId = null;

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private List<ServiceConnection> _filteredConnections = [];
    private List<ClusterNode>       _leftClusters        = [];
    private List<ClusterNode>       _rightClusters       = [];
    private List<MapEdge>           _edges               = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _allConnections = await ServiceConnectionRepository.GetAllAsync();
        _allServers     = await ServerRepository.GetAllAsync();
        _allServices    = await AppServiceRepository.GetAllAsync();
        _loading = false;
        Recompute();
    }

    private void ClearFilters()
    {
        _filterServerId  = null;
        _filterServiceId = null;
        Recompute();
    }

    // ── Graph computation ─────────────────────────────────────────────────────
    private void Recompute()
    {
        _filteredConnections = _allConnections.Where(c =>
        {
            if (_filterServerId.HasValue &&
                c.SourceServerId != _filterServerId &&
                c.DestinationServerId != _filterServerId)
                return false;

            if (_filterServiceId.HasValue &&
                c.SourceServiceId != _filterServiceId &&
                c.DestinationServiceId != _filterServiceId)
                return false;

            return true;
        }).ToList();

        if (!_filteredConnections.Any())
        {
            _leftClusters  = [];
            _rightClusters = [];
            _edges         = [];
            return;
        }

        // ── Build left clusters (source servers) ──────────────────────────
        _leftClusters = BuildClusters(
            _filteredConnections
                .GroupBy(c => c.SourceServerId)
                .Select(g => (
                    ServerId: g.Key,
                    SvcIds: g.Where(c => c.SourceServiceId.HasValue)
                              .Select(c => c.SourceServiceId!.Value)
                              .Distinct().ToList()
                )),
            prefix: "l");

        // ── Build right clusters (destination servers) ─────────────────────
        _rightClusters = BuildClusters(
            _filteredConnections
                .GroupBy(c => c.DestinationServerId)
                .Select(g => (
                    ServerId: g.Key,
                    SvcIds: g.Select(c => c.DestinationServiceId).Distinct().ToList()
                )),
            prefix: "r");

        // ── Build edges ───────────────────────────────────────────────────
        var edges = new List<MapEdge>();

        foreach (var c in _filteredConnections)
        {
            bool isFromService = c.SourceServiceId.HasValue;
            string leftId = ClusterId("l", c.SourceServerId);

            int srcY;
            if (isFromService)
            {
                var cl  = _leftClusters.FirstOrDefault(x => x.Id == leftId);
                var svc = cl?.Services.FirstOrDefault(s => s.ServiceId == c.SourceServiceId!.Value);
                srcY = svc is not null ? svc.Y + SvcRowH / 2
                     : cl  is not null ? cl.Y + ClusterHeaderH / 2
                     : TopPad;
            }
            else if (c.SourceServerId.HasValue)
            {
                var cl = _leftClusters.FirstOrDefault(x => x.Id == leftId);
                srcY = (cl?.Y ?? TopPad) + ClusterHeaderH / 2;
            }
            else
            {
                continue;
            }

            string rightId = ClusterId("r", c.DestinationServerId);
            var rCl  = _rightClusters.FirstOrDefault(x => x.Id == rightId);
            var dSvc = rCl?.Services.FirstOrDefault(s => s.ServiceId == c.DestinationServiceId);
            int dstY = dSvc is not null ? dSvc.Y + SvcRowH / 2
                     : rCl  is not null ? rCl.Y + ClusterHeaderH / 2
                     : TopPad;

            string label = BuildEdgeLabel(
                c.DestinationService?.Port
                    ?? _allServices.FirstOrDefault(s => s.Id == c.DestinationServiceId)?.Port,
                c.Protocol);

            edges.Add(new MapEdge(isFromService, srcY, dstY, label));
        }

        _edges = edges;

        // ── SVG dimensions ────────────────────────────────────────────────
        int leftBottom  = _leftClusters.Any()  ? _leftClusters.Max(c => c.Y + c.Height)  : TopPad;
        int rightBottom = _rightClusters.Any() ? _rightClusters.Max(c => c.Y + c.Height) : TopPad;
        _svgHeight = Math.Max(leftBottom, rightBottom) + 30;
        _svgWidth  = RightColX + ClusterW + 30;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private List<ClusterNode> BuildClusters(
        IEnumerable<(int? ServerId, List<int> SvcIds)> groups,
        string prefix)
    {
        var result = new List<ClusterNode>();
        int y = TopPad;

        foreach (var (srvId, rawSvcIds) in groups
            .OrderBy(g => g.ServerId.HasValue
                ? (_allServers.FirstOrDefault(s => s.Id == g.ServerId)?.Name ?? "Z")
                : "Z"))
        {
            var srv    = srvId.HasValue ? _allServers.FirstOrDefault(s => s.Id == srvId) : null;
            string name = srv?.Name ?? (srvId.HasValue ? $"Сервер #{srvId}" : "Без сервера");
            string ip   = srv?.IpAddress ?? "";

            var svcIds = rawSvcIds
                .OrderBy(id => _allServices.FirstOrDefault(s => s.Id == id)?.Name ?? "")
                .ToList();

            int svcAreaH = svcIds.Count > 0
                ? ClusterPadTop + svcIds.Count * (SvcRowH + SvcRowGap) - SvcRowGap + ClusterPadBot
                : ClusterPadBot;
            int clusterH = ClusterHeaderH + svcAreaH;

            int svcY0 = y + ClusterHeaderH + ClusterPadTop;
            var svcItems = svcIds
                .Select((id, i) => new ClusterSvcItem(
                    id,
                    _allServices.FirstOrDefault(s => s.Id == id)?.Name ?? $"Сервис #{id}",
                    svcY0 + i * (SvcRowH + SvcRowGap)))
                .ToList();

            result.Add(new ClusterNode(ClusterId(prefix, srvId), name, ip, y, clusterH, svcItems));
            y += clusterH + ClusterGapV;
        }

        return result;
    }

    private static string ClusterId(string prefix, int? srvId)
        => srvId.HasValue ? $"{prefix}-{srvId}" : $"{prefix}-null";

    private static string BuildEdgeLabel(int? port, string? protocol)
    {
        bool hasPort  = port.HasValue;
        bool hasProto = !string.IsNullOrWhiteSpace(protocol);
        if (hasPort && hasProto) return $"{port}/{protocol}";
        if (hasPort)             return $"{port}";
        if (hasProto)            return protocol!;
        return "";
    }

    private static string Truncate(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..maxLen] + "…";

    private static MarkupString SvgText(int x, int y, string anchor, string fill,
                                        int fontSize, string fontWeight, string content)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        return (MarkupString)(
            $"<text x=\"{x}\" y=\"{y}\" text-anchor=\"{anchor}\" fill=\"{fill}\" " +
            $"font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" " +
            $"font-family=\"Roboto, sans-serif\">{encoded}</text>");
    }
}

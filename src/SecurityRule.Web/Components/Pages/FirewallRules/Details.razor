@page "/firewall-rules/{Id:int}"
@rendermode InteractiveServer
@inject IFirewallRuleRepository FirewallRuleRepository
@inject NavigationManager Navigation

@if (_displayRule == null)
{
    @if (!Embedded)
    {
        <PageTitle>Правило фаервола — ...</PageTitle>
    }
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <PageTitle>Правило фаервола — @_ruleTitle</PageTitle>
        <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
                <MudText Typo="Typo.h4">@_ruleTitle</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/firewall-rules/edit/{_displayRule.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>

            @* Source / Destination flow *@
            <MudPaper Elevation="0" Class="pa-3 mb-4"
                      Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    @* Source *@
                    <MudStack AlignItems="AlignItems.Start" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Источник</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (_displayRule.SourceServer != null)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Dns"
                                           Style="margin-left: -6px;"
                                           OnClick="@(() => Navigation.NavigateTo($"/servers/{_displayRule.SourceServer.Id}"))">
                                    @_displayRule.SourceServer.Name
                                </MudButton>
                            }
                            @if (_displayRule.SourceService != null)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.MiscellaneousServices"
                                           Style="margin-left: -6px;"
                                           OnClick="@(() => Navigation.NavigateTo($"/services/{_displayRule.SourceService.Id}"))">
                                    @_displayRule.SourceService.Name
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>

                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" Style="font-size: 2rem;" />

                    @* Destination *@
                    <MudStack AlignItems="AlignItems.Start" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Назначение</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (_displayRule.DestinationServer != null)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Dns"
                                           Style="margin-left: -6px;"
                                           OnClick="@(() => Navigation.NavigateTo($"/servers/{_displayRule.DestinationServer.Id}"))">
                                    @_displayRule.DestinationServer.Name
                                </MudButton>
                            }
                            @if (_displayRule.DestinationService != null)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.MiscellaneousServices"
                                           Style="margin-left: -6px;"
                                           OnClick="@(() => Navigation.NavigateTo($"/services/{_displayRule.DestinationService.Id}"))">
                                    @_displayRule.DestinationService.Name
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Протокол</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_displayRule.Protocol) ? "—" : _displayRule.Protocol)</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Действие</MudText>
                    @if (_displayRule.Action == "Allow")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Разрешить</MudChip>
                    }
                    else if (_displayRule.Action == "Deny")
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Запретить</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_displayRule.Action) ? "—" : _displayRule.Action)</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Направление</MudText>
                    @if (_displayRule.Direction == "Inbound")
                    {
                        <MudText Typo="Typo.body1">Входящее</MudText>
                    }
                    else if (_displayRule.Direction == "Outbound")
                    {
                        <MudText Typo="Typo.body1">Исходящее</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_displayRule.Direction) ? "—" : _displayRule.Direction)</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Истекает</MudText>
                    @if (_displayRule.ExpiresAt.HasValue)
                    {
                        <MudText Typo="Typo.body1">
                            @_displayRule.ExpiresAt.Value.ToString("dd.MM.yyyy")
                            @if (_displayRule.ExpiresAt < DateTime.Now)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-1">Истёк</MudChip>
                            }
                            else if (_displayRule.ExpiresAt < DateTime.Now.AddDays(30))
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-1">Скоро истекает</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-1">Активен</MudChip>
                            }
                        </MudText>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Бессрочно</MudChip>
                    }
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_displayRule.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Описание</MudText>
                        <MudText Typo="Typo.body1">@_displayRule.Description</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public FirewallRule? Rule { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;

    private FirewallRule? _displayRule;
    private string _ruleTitle = string.Empty;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        if (Rule is not null)
        {
            _displayRule = Rule;
        }
        else
        {
            _displayRule = await FirewallRuleRepository.GetByIdAsync(Id);
        }
        _ruleTitle = BuildTitle(_displayRule, Id);
        if (!Embedded && Rule is null)
        {
            _breadcrumbs =
            [
                new BreadcrumbItem("Правила фаервола", href: "/firewall-rules"),
                new BreadcrumbItem(_ruleTitle, href: null, disabled: true)
            ];
        }
    }

    private static string BuildTitle(FirewallRule? rule, int fallbackId)
        => rule is null
            ? fallbackId.ToString()
            : $"{rule.SourceServer?.Name ?? "?"} / {rule.SourceService?.Name ?? "?"} → {rule.DestinationServer?.Name ?? "?"} / {rule.DestinationService?.Name ?? "?"}";
}

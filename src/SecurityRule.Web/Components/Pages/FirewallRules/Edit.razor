@page "/firewall-rules/edit/{Id:int}"
@rendermode InteractiveServer
@inject IFirewallRuleRepository FirewallRuleRepository
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Редактировать правило фаервола</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Редактировать правило фаервола</MudText>

@if (_rule == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" Class="mb-3" Color="Color.Secondary">Источник</MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="@_srcServerId" Label="Сервер (источник)" Required="true"
                               ValueChanged="@OnSrcServerChanged">
                        <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                        @foreach (var s in _allServers)
                        {
                            <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="@_srcServiceId" Label="Сервис (источник)" Required="true"
                               Disabled="@(_srcServerId == null || !_srcServices.Any())"
                               ValueChanged="@(id => _srcServiceId = id)">
                        <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                        @foreach (var svc in _srcServices)
                        {
                            <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name@(svc.Port.HasValue ? $" (:{svc.Port})" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1" Class="mb-3" Color="Color.Secondary">Назначение</MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="@_dstServerId" Label="Сервер (назначение)" Required="true"
                               ValueChanged="@OnDstServerChanged">
                        <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                        @foreach (var s in _allServers)
                        {
                            <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="@_dstServiceId" Label="Сервис (назначение)" Required="true"
                               Disabled="@(_dstServerId == null || !_dstServices.Any())"
                               ValueChanged="@(id => _dstServiceId = id)">
                        <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                        @foreach (var svc in _dstServices)
                        {
                            <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name@(svc.Port.HasValue ? $" (:{svc.Port})" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_rule.Protocol" Label="Протокол" Required="true">
                        <MudSelectItem Value="@("TCP")">TCP</MudSelectItem>
                        <MudSelectItem Value="@("UDP")">UDP</MudSelectItem>
                        <MudSelectItem Value="@("ICMP")">ICMP</MudSelectItem>
                        <MudSelectItem Value="@("Any")">Any</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_rule.Action" Label="Действие" Required="true">
                        <MudSelectItem Value="@("Allow")">Разрешить</MudSelectItem>
                        <MudSelectItem Value="@("Deny")">Запретить</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_rule.Direction" Label="Направление" Required="true">
                        <MudSelectItem Value="@("Inbound")">Входящее</MudSelectItem>
                        <MudSelectItem Value="@("Outbound")">Исходящее</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_expiresAt" Label="Дата истечения"
                                   HelperText="Оставьте пустым — без ограничения срока" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_rule.Description" Label="Описание" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/firewall-rules"))">Отмена</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@Delete">
                Удалить
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    private FirewallRule? _rule;
    private DateTime? _expiresAt;
    private int? _srcServerId;
    private int? _srcServiceId;
    private int? _dstServerId;
    private int? _dstServiceId;
    private IEnumerable<Server> _allServers = [];
    private IEnumerable<AppService> _srcServices = [];
    private IEnumerable<AppService> _dstServices = [];

    protected override async Task OnInitializedAsync()
    {
        _allServers = await ServerRepository.GetAllAsync();
        _rule = await FirewallRuleRepository.GetByIdAsync(Id);
        if (_rule != null)
        {
            _expiresAt    = _rule.ExpiresAt;
            _srcServerId  = _rule.SourceServerId;
            _srcServiceId = _rule.SourceServiceId;
            _dstServerId  = _rule.DestinationServerId;
            _dstServiceId = _rule.DestinationServiceId;
            _srcServices  = _allServers.FirstOrDefault(s => s.Id == _srcServerId)?.Services ?? [];
            _dstServices  = _allServers.FirstOrDefault(s => s.Id == _dstServerId)?.Services ?? [];
        }
    }

    private void OnSrcServerChanged(int? serverId)
    {
        _srcServerId  = serverId;
        _srcServiceId = null;
        _srcServices  = serverId.HasValue
            ? _allServers.FirstOrDefault(s => s.Id == serverId.Value)?.Services ?? []
            : [];
    }

    private void OnDstServerChanged(int? serverId)
    {
        _dstServerId  = serverId;
        _dstServiceId = null;
        _dstServices  = serverId.HasValue
            ? _allServers.FirstOrDefault(s => s.Id == serverId.Value)?.Services ?? []
            : [];
    }

    private async Task Save()
    {
        if (_rule == null) return;

        if (_srcServerId is null || _srcServiceId is null || _dstServerId is null || _dstServiceId is null)
        {
            Snackbar.Add("Все четыре поля (серверы и сервисы) обязательны", Severity.Warning);
            return;
        }

        _rule.SourceServerId       = _srcServerId.Value;
        _rule.SourceServiceId      = _srcServiceId.Value;
        _rule.DestinationServerId  = _dstServerId.Value;
        _rule.DestinationServiceId = _dstServiceId.Value;
        _rule.ExpiresAt            = _expiresAt;

        await FirewallRuleRepository.UpdateAsync(_rule);
        Snackbar.Add("Правило обновлено", Severity.Success);
        Navigation.NavigateTo("/firewall-rules");
    }

    private async Task Delete()
    {
        try
        {
            await FirewallRuleRepository.DeleteAsync(Id);
            Snackbar.Add("Правило удалено", Severity.Success);
            Navigation.NavigateTo("/firewall-rules");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении правила: {ex.Message}", Severity.Error);
        }
    }
}

@page "/firewall-rules/create"
@rendermode InteractiveServer
@inject IFirewallRuleRepository FirewallRuleRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Добавить правило фаервола</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Добавить правило фаервола</MudText>

<MudCard>
    <MudCardContent>
        <MudSelect T="int?" Value="@_selectedServerId" Label="Сервер (источник)" Clearable="true" Class="mb-3"
                   ValueChanged="@OnServerChanged">
            <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
            @foreach (var server in _allServers)
            {
                <MudSelectItem T="int?" Value="@((int?)server.Id)">@server.Name (@server.IpAddress)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_rule.SourceIp" Label="Исходящий IP адрес" Class="mb-3"
                      HelperText="Заполняется автоматически при выборе сервера" />
        <MudSelect T="int?" Value="@_selectedServiceId" Label="Сервис (назначение)" Clearable="true" Class="mb-3"
                   ValueChanged="@OnServiceChanged">
            <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
            @foreach (var svc in _allServices)
            {
                <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name@(svc.Port.HasValue ? $" (:{svc.Port})" : "")</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_rule.DestinationIp" Label="Входящий IP адрес" Class="mb-3"
                      HelperText="Заполняется автоматически при выборе сервиса или укажите вручную" />
        <MudTextField @bind-Value="_portText" Label="Порт назначения" Class="mb-3"
                      InputType="InputType.Number"
                      HelperText="Заполняется автоматически при выборе сервиса или укажите вручную" />
        <MudSelect @bind-Value="_rule.Protocol" Label="Протокол" Required="true" Class="mb-3">
            <MudSelectItem Value="@("TCP")">TCP</MudSelectItem>
            <MudSelectItem Value="@("UDP")">UDP</MudSelectItem>
            <MudSelectItem Value="@("ICMP")">ICMP</MudSelectItem>
            <MudSelectItem Value="@("Any")">Any</MudSelectItem>
        </MudSelect>
        <MudSelect @bind-Value="_rule.Action" Label="Действие" Required="true" Class="mb-3">
            <MudSelectItem Value="@("Allow")">Разрешить</MudSelectItem>
            <MudSelectItem Value="@("Deny")">Запретить</MudSelectItem>
        </MudSelect>
        <MudSelect @bind-Value="_rule.Direction" Label="Направление" Required="true" Class="mb-3">
            <MudSelectItem Value="@("Inbound")">Входящее</MudSelectItem>
            <MudSelectItem Value="@("Outbound")">Исходящее</MudSelectItem>
        </MudSelect>
        <MudDatePicker @bind-Date="_expiresAt" Label="Дата истечения" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_rule.Description" Label="Описание" Class="mb-3" Lines="3" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/firewall-rules"))">Отмена</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private FirewallRule _rule = new() { Protocol = "TCP", Action = "Allow", Direction = "Inbound" };
    private DateTime? _expiresAt = DateTime.Now.AddYears(1);
    private string _portText = string.Empty;
    private int? _selectedServerId;
    private int? _selectedServiceId;
    private IEnumerable<Server> _allServers = [];
    private IEnumerable<AppService> _allServices = [];

    protected override async Task OnInitializedAsync()
    {
        _allServers = await ServerRepository.GetAllAsync();
        _allServices = await AppServiceRepository.GetAllAsync();
    }

    private void OnServerChanged(int? serverId)
    {
        _selectedServerId = serverId;
        var server = _allServers.FirstOrDefault(s => s.Id == serverId);
        if (server != null)
            _rule.SourceIp = server.IpAddress;
        else if (_selectedServerId == null)
            _rule.SourceIp = string.Empty;
    }

    private void OnServiceChanged(int? serviceId)
    {
        _selectedServiceId = serviceId;
        var service = _allServices.FirstOrDefault(s => s.Id == serviceId);
        if (service != null)
        {
            if (service.Port.HasValue)
                _portText = service.Port.Value.ToString();
        }
        else if (_selectedServiceId == null)
        {
            _portText = string.Empty;
        }
    }

    private async Task Save()
    {
        _rule.ExpiresAt = _expiresAt ?? DateTime.Now.AddYears(1);
        _rule.DestinationPort = int.TryParse(_portText, out var p) ? p : null;
        _rule.ServerId = _selectedServerId;
        _rule.ServiceId = _selectedServiceId;
        await FirewallRuleRepository.AddAsync(_rule);
        Snackbar.Add("Правило добавлено", Severity.Success);
        Navigation.NavigateTo("/firewall-rules");
    }
}

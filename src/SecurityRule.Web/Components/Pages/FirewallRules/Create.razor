@page "/connections/create"
@rendermode InteractiveServer
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Добавить связь</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Добавить связь</MudText>

<MudCard>
    <MudCardContent>
        <MudText Typo="Typo.subtitle1" Class="mb-3" Color="Color.Secondary">Источник</MudText>
        <MudGrid Class="mb-2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Value="@_srcServerId" Label="Сервер (источник)"
                           ValueChanged="@OnSrcServerChanged">
                    <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                    @foreach (var s in _allServers)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Value="@_srcServiceId" Label="Сервис (источник)"
                           Disabled="@(_srcServerId != null && !_srcServices.Any())"
                           ValueChanged="@(id => _srcServiceId = id)">
                    <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                    @foreach (var svc in _srcServices)
                    {
                        <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name@(svc.Port.HasValue ? $" (:{svc.Port})" : "")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle1" Class="mb-3" Color="Color.Secondary">Назначение</MudText>
        <MudGrid Class="mb-2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Value="@_dstServerId" Label="Сервер (назначение)"
                           ValueChanged="@OnDstServerChanged">
                    <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                    @foreach (var s in _allServers)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name (@s.IpAddress)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Value="@_dstServiceId" Label="Сервис назначения (обязательно)" Required="true" RequiredError="Выберите сервис назначения"
                           Disabled="@(_dstServerId != null && !_dstServices.Any())"
                           ValueChanged="@(id => _dstServiceId = id)">
                    <MudSelectItem T="int?" Value="@((int?)null)">— не выбрано —</MudSelectItem>
                    @foreach (var svc in _dstServices)
                    {
                        <MudSelectItem T="int?" Value="@((int?)svc.Id)">@svc.Name@(svc.Port.HasValue ? $" (:{svc.Port})" : "")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="_protocol" Label="Протокол">
                    <MudSelectItem Value="@("")">— не выбрано —</MudSelectItem>
                    <MudSelectItem Value="@("TCP")">TCP</MudSelectItem>
                    <MudSelectItem Value="@("UDP")">UDP</MudSelectItem>
                    <MudSelectItem Value="@("ICMP")">ICMP</MudSelectItem>
                    <MudSelectItem Value="@("Any")">Any</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_port" Label="Порт" Min="1" Max="65535"
                                 HelperText="Оставьте пустым, если не применимо" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/connections"))">Отмена</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private string _protocol = string.Empty;
    private int? _port;
    private int? _srcServerId;
    private int? _srcServiceId;
    private int? _dstServerId;
    private int? _dstServiceId;
    private IEnumerable<Server> _allServers = [];
    private IEnumerable<AppService> _allServices = [];
    private IEnumerable<AppService> _srcServices = [];
    private IEnumerable<AppService> _dstServices = [];

    protected override async Task OnInitializedAsync()
    {
        _allServers  = await ServerRepository.GetAllAsync();
        _allServices = await AppServiceRepository.GetAllAsync();
        _srcServices = _allServices;
        _dstServices = _allServices;
    }

    private void OnSrcServerChanged(int? serverId)
    {
        _srcServerId  = serverId;
        _srcServiceId = null;
        _srcServices  = serverId.HasValue
            ? _allServers.FirstOrDefault(s => s.Id == serverId.Value)?.Services ?? []
            : _allServices;
    }

    private void OnDstServerChanged(int? serverId)
    {
        _dstServerId  = serverId;
        _dstServiceId = null;
        _dstServices  = serverId.HasValue
            ? _allServers.FirstOrDefault(s => s.Id == serverId.Value)?.Services ?? []
            : _allServices;
    }

    private async Task Save()
    {
        if (_dstServiceId is null)
        {
            Snackbar.Add("Сервис назначения обязателен", Severity.Warning);
            return;
        }

        var connection = new ServiceConnection
        {
            SourceServerId       = _srcServerId,
            SourceServiceId      = _srcServiceId,
            DestinationServerId  = _dstServerId,
            DestinationServiceId = _dstServiceId.Value,
            Protocol = _protocol,
            Port     = _port
        };

        await ServiceConnectionRepository.AddAsync(connection);
        Snackbar.Add("Связь добавлена", Severity.Success);
        Navigation.NavigateTo("/connections");
    }
}

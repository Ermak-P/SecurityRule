@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudTable T="FirewallRule" Items="@Items" Hover="true" Striped="true" Dense="true"
          Elevation="@Elevation" OnRowClick="@ToggleRow">
    <HeaderContent>
        <MudTh Style="width:35%">Источник</MudTh>
        <MudTh Style="width:5%; text-align:center;"></MudTh>
        <MudTh Style="width:35%">Назначение</MudTh>
        <MudTh>Протокол</MudTh>
        <MudTh>Действие</MudTh>
        <MudTh>Истекает</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        @{
            var srcServer  = context.SourceServer;
            var srcService = context.SourceService;
            var dstServer  = context.DestinationServer;
            var dstService = context.DestinationService;
        }
        <MudTd DataLabel="Источник" @onmousedown="@(e => HandleMouseDown(e, context.Id))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                <MudIcon Icon="@(_expandedRows.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                         Size="Size.Small" Color="Color.Default" />
                @if (srcServer != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Dns">@srcServer.Name</MudChip>
                }
                @if (srcService != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.MiscellaneousServices">@srcService.Name</MudChip>
                }
            </MudStack>
        </MudTd>
        <MudTd Style="text-align:center; vertical-align:middle;">
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Default" Size="Size.Small" />
        </MudTd>
        <MudTd DataLabel="Назначение">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                @if (dstServer != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Dns">@dstServer.Name</MudChip>
                }
                @if (dstService != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.MiscellaneousServices">@dstService.Name</MudChip>
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Протокол">@(string.IsNullOrWhiteSpace(context.Protocol) ? "—" : context.Protocol)</MudTd>
        <MudTd DataLabel="Действие">
            @if (context.Action == "Allow")
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Разрешить</MudChip>
            }
            else if (context.Action == "Deny")
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small">Запретить</MudChip>
            }
            else
            {
                @context.Action
            }
        </MudTd>
        <MudTd DataLabel="Истекает">
            @if (context.ExpiresAt.HasValue)
            {
                @context.ExpiresAt.Value.ToString("dd.MM.yyyy")
                @if (context.ExpiresAt < DateTime.Now)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-1">Истёк</MudChip>
                }
                else if (context.ExpiresAt < DateTime.Now.AddDays(30))
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-1">Скоро</MudChip>
                }
            }
            else
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Бессрочно</MudChip>
            }
        </MudTd>
        <MudTd Style="text-align:right">
            <span @onclick:stopPropagation="true">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                               Title="Редактировать"
                               OnClick="@(() => Navigation.NavigateTo($"/firewall-rules/edit/{context.Id}"))" />
            </span>
        </MudTd>
    </RowTemplate>
    <ChildRowContent Context="rule">
        @if (_expandedRows.Contains(rule.Id))
        {
            <MudTr>
                <td colspan="7" style="padding: 0; background: var(--mud-palette-background-grey);">
                    <div style="border-left: 3px solid var(--mud-palette-primary); margin: 8px 16px 12px 36px; padding-left: 16px;">
                        <Details Rule="rule" Embedded="true" />
                    </div>
                </td>
            </MudTr>
        }
    </ChildRowContent>
</MudTable>

@code {
    [Parameter] public IEnumerable<FirewallRule> Items { get; set; } = [];
    [Parameter] public int Elevation { get; set; } = 1;

    private readonly HashSet<int> _expandedRows = [];

    private async Task ToggleRow(TableRowClickEventArgs<FirewallRule> args)
    {
        if (args.Item is null) return;
        if (args.MouseEventArgs.CtrlKey || args.MouseEventArgs.MetaKey)
        {
            await JS.InvokeVoidAsync("open", $"/firewall-rules/{args.Item.Id}", "_blank");
            return;
        }
        var id = args.Item.Id;
        if (!_expandedRows.Remove(id))
            _expandedRows.Add(id);
    }

    private async Task HandleMouseDown(MouseEventArgs e, int id)
    {
        if (e.Button == 1)
            await JS.InvokeVoidAsync("open", $"/firewall-rules/{id}", "_blank");
    }
}

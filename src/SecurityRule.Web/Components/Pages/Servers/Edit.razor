@page "/servers/edit/{Id:int}"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Редактировать сервер</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Редактировать сервер</MudText>

@if (_server == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudTextField @bind-Value="_server.Name" Label="Название" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_server.IpAddress" Label="IP адрес" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_server.OperatingSystem" Label="Операционная система" Required="true" Class="mb-3" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo($"/servers/{Id}"))">Отмена</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@Delete">
                Удалить
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    private Server? _server;

    protected override async Task OnInitializedAsync()
    {
        _server = await ServerRepository.GetByIdAsync(Id);
    }

    private async Task Save()
    {
        if (_server != null)
        {
            await ServerRepository.UpdateAsync(_server);
            Snackbar.Add("Сервер обновлён", Severity.Success);
            Navigation.NavigateTo($"/servers/{Id}");
        }
    }

    private async Task Delete()
    {
        try
        {
            await ServerRepository.DeleteAsync(Id);
            Snackbar.Add("Сервер удалён", Severity.Success);
            Navigation.NavigateTo("/servers");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении сервера: {ex.Message}", Severity.Error);
        }
    }
}

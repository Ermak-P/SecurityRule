@page "/servers/{Id:int}"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation

<PageTitle>Сервер — @(_server?.Name ?? "...")</PageTitle>

@if (_server == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
    <ServerDetails Server="_server" />
}

@code {
    [Parameter] public int Id { get; set; }
    private Server? _server;

    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _server = await ServerRepository.GetByIdAsync(Id);
        _breadcrumbs =
        [
            new BreadcrumbItem("Серверы", href: "/servers"),
            new BreadcrumbItem(_server?.Name ?? Id.ToString(), href: null, disabled: true)
        ];
    }
}

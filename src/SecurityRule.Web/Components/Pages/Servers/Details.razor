@page "/servers/{Id:int}"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Сервер — @(_server?.Name ?? "...")</PageTitle>

@if (_server == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" />
            <MudText Typo="Typo.h4">@_server.Name</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Navigation.NavigateTo($"/servers/edit/{_server.Id}"))">
            Редактировать
        </MudButton>
    </MudStack>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">IP адрес</MudText>
                    <MudText Typo="Typo.body1">@_server.IpAddress</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Операционная система</MudText>
                    <MudText Typo="Typo.body1">@_server.OperatingSystem</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Количество сервисов</MudText>
                    <MudText Typo="Typo.body1">@_server.Services.Count</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Class="mr-1" />
        Сервисы
    </MudText>

    @if (!_server.Services.Any())
    {
        <MudAlert Severity="Severity.Info">На этом сервере нет сервисов</MudAlert>
    }
    else
    {
        <MudTable T="AppService" Items="@_server.Services" Hover="true" Striped="true" Dense="true" OnRowClick="@ToggleServiceRow">
            <HeaderContent>
                <MudTh>Название</MudTh>
                <MudTh>AD учётная запись</MudTh>
                <MudTh>Сертификаты</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Название">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@(_expandedServiceRows.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                        @context.Name
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="AD учётная запись">@context.AdAccountName</MudTd>
                <MudTd DataLabel="Сертификаты">@context.Certificates.Count</MudTd>
            </RowTemplate>
            <ChildRowContent Context="svc">
                @if (_expandedServiceRows.Contains(svc.Id))
                {
                    <MudTr>
                        <td colspan="3" style="padding: 8px 16px 16px 40px; background: var(--mud-palette-background-grey);">
                            <MudText Typo="Typo.body2"><strong>AD учётная запись:</strong> @svc.AdAccountName</MudText>
                            @if (svc.Certificates.Any())
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>Сертификаты:</strong></MudText>
                                @foreach (var cert in svc.Certificates)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">@cert.Description (@cert.ExpiresAt.ToString("dd.MM.yyyy"))</MudChip>
                                }
                            }
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private Server? _server;

    private List<BreadcrumbItem> _breadcrumbs = [];
    private readonly HashSet<int> _expandedServiceRows = [];

    protected override async Task OnInitializedAsync()
    {
        _server = await ServerRepository.GetByIdAsync(Id);
        _breadcrumbs =
        [
            new BreadcrumbItem("Серверы и сервисы", href: "/servers-and-services"),
            new BreadcrumbItem("Серверы", href: "/servers"),
            new BreadcrumbItem(_server?.Name ?? Id.ToString(), href: null, disabled: true)
        ];
    }

    private void ToggleServiceRow(TableRowClickEventArgs<AppService> args)
    {
        if (args.Item is null) return;
        var id = args.Item.Id;
        if (!_expandedServiceRows.Remove(id))
            _expandedServiceRows.Add(id);
    }
}

@page "/servers/{Id:int}"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Сервер — @(_server?.Name ?? "...")</PageTitle>

@if (_server == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" />
            <MudText Typo="Typo.h4">@_server.Name</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Navigation.NavigateTo($"/servers/edit/{_server.Id}"))">
            Редактировать
        </MudButton>
    </MudStack>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">IP адрес</MudText>
                    <MudText Typo="Typo.body1">@_server.IpAddress</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Операционная система</MudText>
                    <MudText Typo="Typo.body1">@_server.OperatingSystem</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Количество сервисов</MudText>
                    <MudText Typo="Typo.body1">@_server.Services.Count</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Class="mr-1" />
        Сервисы
    </MudText>

    @if (!_server.Services.Any())
    {
        <MudAlert Severity="Severity.Info">На этом сервере нет сервисов</MudAlert>
    }
    else
    {
        <MudTable Items="@_server.Services" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Название</MudTh>
                <MudTh>AD учётная запись</MudTh>
                <MudTh>Сертификаты</MudTh>
                <MudTh>Открыть</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Название">@context.Name</MudTd>
                <MudTd DataLabel="AD учётная запись">@context.AdAccountName</MudTd>
                <MudTd DataLabel="Сертификаты">@context.Certificates.Count</MudTd>
                <MudTd>
                    <MudTooltip Text="Открыть в новом окне">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenServiceNewTab(context.Id))" />
                    </MudTooltip>
                    <MudTooltip Text="Открыть в модальном окне">
                        <MudIconButton Icon="@Icons.Material.Filled.Pageview" Color="Color.Secondary" Size="Size.Small"
                                       OnClick="@(() => OpenServiceModal(context.Id))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private Server? _server;

    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _server = await ServerRepository.GetByIdAsync(Id);
        _breadcrumbs =
        [
            new BreadcrumbItem("Серверы и сервисы", href: "/servers-and-services"),
            new BreadcrumbItem("Серверы", href: "/servers"),
            new BreadcrumbItem(_server?.Name ?? Id.ToString(), href: null, disabled: true)
        ];
    }

    async Task OpenServiceNewTab(int id) => await JS.InvokeVoidAsync("open", $"/services/{id}", "_blank");

    async Task OpenServiceModal(int id)
    {
        var parameters = new DialogParameters<ServiceDetailsDialog> { { p => p.ServiceId, id } };
        await DialogService.ShowAsync<ServiceDetailsDialog>("Сервис", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }
}

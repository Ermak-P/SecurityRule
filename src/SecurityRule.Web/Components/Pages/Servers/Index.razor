@page "/servers"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Серверы</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Серверы</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="@(() => Navigation.NavigateTo("/servers/create"))" Class="mb-4">
    Добавить сервер
</MudButton>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_servers" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Название</MudTh>
            <MudTh>IP адрес</MudTh>
            <MudTh>Операционная система</MudTh>
            <MudTh>Сервисы</MudTh>
            <MudTh>Открыть</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Название">@context.Name</MudTd>
            <MudTd DataLabel="IP адрес">@context.IpAddress</MudTd>
            <MudTd DataLabel="Операционная система">@context.OperatingSystem</MudTd>
            <MudTd DataLabel="Сервисы">@context.Services.Count</MudTd>
            <MudTd>
                <MudTooltip Text="Открыть в новом окне">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary"
                                   OnClick="@(() => OpenNewTab($"/servers/{context.Id}"))" />
                </MudTooltip>
                <MudTooltip Text="Открыть в модальном окне">
                    <MudIconButton Icon="@Icons.Material.Filled.Pageview" Color="Color.Secondary"
                                   OnClick="@(() => OpenModal(context.Id))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<Server> _servers = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _servers = await ServerRepository.GetAllAsync();
        _loading = false;
    }

    async Task OpenNewTab(string url) => await JS.InvokeVoidAsync("open", url, "_blank");

    async Task OpenModal(int id)
    {
        var parameters = new DialogParameters<ServerDetailsDialog> { { p => p.ServerId, id } };
        await DialogService.ShowAsync<ServerDetailsDialog>("Сервер", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }
}

@page "/servers"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation

<PageTitle>Серверы</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Серверы</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Управление серверами инфраструктуры</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/servers/create"))">Добавить</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_servers" />
}

@code {
    private IEnumerable<Server> _servers = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _servers = await ServerRepository.GetAllAsync();
        _loading = false;
    }
}

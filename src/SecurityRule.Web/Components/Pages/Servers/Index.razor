@page "/servers"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject NavigationManager Navigation

<PageTitle>Серверы</PageTitle>

<MudStack Row="true" Spacing="1">
    <MudText Typo="Typo.h4" GutterBottom="true">Серверы</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                   Title="Добавить"
                   OnClick="@(() => Navigation.NavigateTo($"/servers/create"))" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_servers" />
}

@code {
    private IEnumerable<Server> _servers = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _servers = await ServerRepository.GetAllAsync();
        _loading = false;
    }
}

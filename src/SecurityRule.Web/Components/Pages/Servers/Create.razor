@page "/servers/create"
@rendermode InteractiveServer
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject IOperatingSystemRepository OperatingSystemRepository
@inject ITagRepository TagRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Добавить сервер</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Добавить сервер</MudText>

<MudCard>
    <MudCardContent>
        <MudTextField @bind-Value="_server.Name" Label="Название" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_server.IpAddress" Label="IP адрес" Required="true" Class="mb-3" />
        <MudAutocomplete T="string" @bind-Value="_server.OperatingSystem"
                         Label="Операционная система" Required="true" Class="mb-3"
                         SearchFunc="@SearchOs" CoerceText="true" />
        <MudTextField @bind-Value="_server.Description" Label="Описание" Lines="3" Class="mb-3" />
        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_selectedServiceIds"
                   Label="Сервисы" Class="mb-3"
                   ToStringFunc="@(id => _allServices.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
            @foreach (var service in _allServices)
            {
                <MudSelectItem Value="@service.Id">@service.Name</MudSelectItem>
            }
        </MudSelect>
        <MudAutocomplete T="string" Label="Теги" Class="mb-3"
                         SearchFunc="@SearchTags" CoerceText="true"
                         Value="@_tagInput" ValueChanged="@AddTag"
                         Placeholder="Введите тег и нажмите Enter" />
        @if (_selectedTags.Count > 0)
        {
            <MudChipSet T="string" Class="mb-2">
                @foreach (var tag in _selectedTags)
                {
                    <MudChip T="string" Value="@tag" OnClose="@(() => RemoveTag(tag))" Color="Color.Info" Size="Size.Small">@tag</MudChip>
                }
            </MudChipSet>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/servers"))">Отмена</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private Server _server = new();
    private IEnumerable<AppService> _allServices = [];
    private IReadOnlyCollection<int> _selectedServiceIds = [];
    private IEnumerable<string> _osOptions = [];
    private IEnumerable<string> _allTagNames = [];
    private HashSet<string> _selectedTags = [];
    private string _tagInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _allServices = await AppServiceRepository.GetAllAsync();
        _osOptions = (await OperatingSystemRepository.GetAllAsync()).Select(o => o.Name);
        _allTagNames = (await TagRepository.GetAllAsync()).Select(t => t.Name);
    }

    private Task<IEnumerable<string>> SearchOs(string value, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_osOptions);
        return Task.FromResult(_osOptions.Where(o => o.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<string>> SearchTags(string value, CancellationToken _)
    {
        var available = _allTagNames.Where(t => !_selectedTags.Contains(t));
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(available);
        return Task.FromResult(available.Where(t => t.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task AddTag(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var trimmed = value.Trim();
        if (_selectedTags.Add(trimmed) && !_allTagNames.Contains(trimmed))
            _allTagNames = _allTagNames.Append(trimmed);
        _tagInput = string.Empty;
        await Task.CompletedTask;
    }

    private void RemoveTag(string tag) => _selectedTags.Remove(tag);

    private async Task Save()
    {
        _server.Services = _allServices.Where(s => _selectedServiceIds.Contains(s.Id)).ToList();
        _server.Tags = [];
        foreach (var tagName in _selectedTags)
            _server.Tags.Add(await TagRepository.GetOrCreateAsync(tagName));
        await ServerRepository.AddAsync(_server);
        Snackbar.Add("Сервер добавлен", Severity.Success);
        Navigation.NavigateTo("/servers");
    }
}

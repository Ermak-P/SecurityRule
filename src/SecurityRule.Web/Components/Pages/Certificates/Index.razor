@page "/certificates"
@rendermode InteractiveServer
@inject ICertificateRepository CertificateRepository
@inject NavigationManager Navigation

<PageTitle>Сертификаты</PageTitle>

<MudStack Row="true" Spacing="1">
    <MudText Typo="Typo.h4" GutterBottom="true">Сертификаты</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                   Title="Добавить"
                   OnClick="@(() => Navigation.NavigateTo($"/certificates/create"))" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_certificates" />
}

@code {
    private IEnumerable<Certificate> _certificates = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _certificates = await CertificateRepository.GetAllAsync();
        _loading = false;
    }
}

@page "/certificates"
@rendermode InteractiveServer
@inject ICertificateRepository CertificateRepository
@inject NavigationManager Navigation

<PageTitle>Сертификаты</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Сертификаты</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">SSL/TLS сертификаты</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/certificates/create"))">Добавить</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_certificates" />
}

@code {
    private IEnumerable<Certificate> _certificates = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _certificates = await CertificateRepository.GetAllAsync();
        _loading = false;
    }
}

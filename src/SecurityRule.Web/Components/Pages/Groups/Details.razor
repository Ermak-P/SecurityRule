@page "/groups/{Id:int}"
@rendermode InteractiveServer
@inject IGroupRepository GroupRepository
@inject NavigationManager Navigation

@if (_group == null)
{
    @if (!Embedded)
    {
        <PageTitle>Группа — ...</PageTitle>
    }
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <PageTitle>Группа — @_group.Name</PageTitle>
        <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Tertiary" />
                <MudText Typo="Typo.h4">@_group.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/groups/edit/{_group.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Название</MudText>
                    <MudText Typo="Typo.body1">@_group.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Дочерних групп</MudText>
                    <MudText Typo="Typo.body1">@_group.ChildGroups.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Пользователей</MudText>
                    <MudText Typo="Typo.body1">@_group.Users.Count</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_group.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Описание</MudText>
                        <MudText Typo="Typo.body1">@_group.Description</MudText>
                    </MudItem>
                }
                @if (_group.ParentGroups.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Входит в группы</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var parent in _group.ParentGroups)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                         OnClick="@(() => Navigation.NavigateTo($"/groups/{parent.Id}"))">
                                    @parent.Name
                                </MudChip>
                            }
                        </MudStack>
                    </MudItem>
                }
                @if (_group.ChildGroups.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Дочерние группы</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var child in _group.ChildGroups)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                         OnClick="@(() => Navigation.NavigateTo($"/groups/{child.Id}"))">
                                    @child.Name
                                </MudChip>
                            }
                        </MudStack>
                    </MudItem>
                }
                @if (_group.Users.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Пользователи</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var user in _group.Users)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                                         OnClick="@(() => Navigation.NavigateTo($"/users/{user.Id}"))">
                                    @user.Name
                                </MudChip>
                            }
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public Group? Group { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;

    private Group? _group;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        if (Group is not null)
        {
            _group = Group;
        }
        else
        {
            _group = await GroupRepository.GetByIdAsync(Id);
            _breadcrumbs =
            [
                new BreadcrumbItem("Группы", href: "/groups"),
                new BreadcrumbItem(_group?.Name ?? Id.ToString(), href: null, disabled: true)
            ];
        }
    }
}

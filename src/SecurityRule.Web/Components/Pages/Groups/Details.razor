@page "/groups/{Id:int}"
@rendermode InteractiveServer
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject IAdService AdService
@inject NavigationManager Navigation

@if (_group == null)
{
    @if (!Embedded)
    {
        <PageTitle>Группа — ...</PageTitle>
    }
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <PageTitle>Группа — @_group.Name</PageTitle>
        <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Tertiary" />
                <MudText Typo="Typo.h4">@_group.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/groups/edit/{_group.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Название</MudText>
                    <MudText Typo="Typo.body1">@_group.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Дочерних групп (AD)</MudText>
                    <MudText Typo="Typo.body1">@_childGroups.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Пользователей (AD)</MudText>
                    <MudText Typo="Typo.body1">@_memberUsers.Count</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_group.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Описание</MudText>
                        <MudText Typo="Typo.body1">@_group.Description</MudText>
                    </MudItem>
                }
                @if (_parentGroups.Count > 0)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Входит в группы (AD)</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var item in _parentGroups)
                            {
                                @if (item.DbGroup != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                             OnClick="@(() => Navigation.NavigateTo($"/groups/{item.DbGroup.Id}"))">
                                        @item.Name
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        @item.Name
                                    </MudChip>
                                }
                            }
                        </MudStack>
                    </MudItem>
                }
                @if (_childGroups.Count > 0)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Дочерние группы (AD)</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var item in _childGroups)
                            {
                                @if (item.DbGroup != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                             OnClick="@(() => Navigation.NavigateTo($"/groups/{item.DbGroup.Id}"))">
                                        @item.Name
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        @item.Name
                                    </MudChip>
                                }
                            }
                        </MudStack>
                    </MudItem>
                }
                @if (_memberUsers.Count > 0)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Пользователи (AD)</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var item in _memberUsers)
                            {
                                @if (item.DbUser != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                                             OnClick="@(() => Navigation.NavigateTo($"/users/{item.DbUser.Id}"))">
                                        @item.Name
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        @item.Name
                                    </MudChip>
                                }
                            }
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public Group? Group { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;

    private record AdGroupItem(string Name, Group? DbGroup);
    private record AdUserItem(string Name, User? DbUser);

    private Group? _group;
    private List<AdGroupItem> _parentGroups = [];
    private List<AdGroupItem> _childGroups = [];
    private List<AdUserItem> _memberUsers = [];
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        if (Group is not null)
        {
            _group = Group;
        }
        else
        {
            _group = await GroupRepository.GetByIdAsync(Id);
            _breadcrumbs =
            [
                new BreadcrumbItem("Группы", href: "/groups"),
                new BreadcrumbItem(_group?.Name ?? Id.ToString(), href: null, disabled: true)
            ];
        }

        if (_group != null)
        {
            var allDbGroups = await GroupRepository.GetAllAsync();
            var allDbUsers = await UserRepository.GetAllAsync();
            var dbGroupsByName = allDbGroups.ToDictionary(g => g.Name, StringComparer.OrdinalIgnoreCase);
            var dbUsersByName = allDbUsers.ToDictionary(u => u.Name, StringComparer.OrdinalIgnoreCase);

            var parentNames = await AdService.GetGroupParentGroupNamesAsync(_group.Name);
            _parentGroups = parentNames
                .Select(n => new AdGroupItem(n, dbGroupsByName.TryGetValue(n, out var g) ? g : null))
                .ToList();

            var childNames = await AdService.GetGroupChildGroupNamesAsync(_group.Name);
            _childGroups = childNames
                .Select(n => new AdGroupItem(n, dbGroupsByName.TryGetValue(n, out var g) ? g : null))
                .ToList();

            var memberNames = await AdService.GetGroupMemberUserNamesAsync(_group.Name);
            _memberUsers = memberNames
                .Select(n => new AdUserItem(n, dbUsersByName.TryGetValue(n, out var u) ? u : null))
                .ToList();
        }
    }
}

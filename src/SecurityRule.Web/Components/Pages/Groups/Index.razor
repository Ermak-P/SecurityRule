@page "/groups"
@rendermode InteractiveServer
@inject IGroupRepository GroupRepository
@inject NavigationManager Navigation

<PageTitle>Группы</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Группы</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Группы пользователей</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/groups/create"))">Добавить</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_groups" />
}

@code {
    private IEnumerable<Group> _groups = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _groups = await GroupRepository.GetAllAsync();
        _loading = false;
    }
}

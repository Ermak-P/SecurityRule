@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudTable T="AdUserItem" Items="@Items" Hover="true" Striped="true" Dense="true"
          Elevation="@Elevation" OnRowClick="@OnRowClick" Style="cursor:pointer">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>В базе данных</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Название" @onmousedown="@(e => HandleMouseDown(e, context))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (!Nested)
                {
                    <MudIcon Icon="@(_expandedRows.Contains(context.Name) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Color="Color.Default" />
                }
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Color="Color.Tertiary" />
                @context.Name
            </MudStack>
        </MudTd>
        <MudTd DataLabel="В базе данных">
            @if (context.DbUser != null)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" Title="Есть в БД" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.Cloud" Size="Size.Small" Color="Color.Default" Title="Только в AD" />
            }
        </MudTd>
    </RowTemplate>
    <ChildRowContent Context="item">
        @if (!Nested && _expandedRows.Contains(item.Name))
        {
            <MudTr>
                <td colspan="2" style="padding: 0; background: var(--mud-palette-background-grey);">
                    <div style="border-left: 3px solid var(--mud-palette-tertiary); margin: 8px 16px 12px 36px; padding-left: 16px;">
                        @if (item.DbUser != null)
                        {
                            <Details User="item.DbUser" Embedded="true" />
                        }
                        else
                        {
                            <Details UserName="item.Name" Embedded="true" />
                        }
                    </div>
                </td>
            </MudTr>
        }
    </ChildRowContent>
</MudTable>

@code {
    [Parameter] public IEnumerable<AdUserItem> Items { get; set; } = [];
    [Parameter] public int Elevation { get; set; } = 1;
    [Parameter] public bool Nested { get; set; } = false;

    public record AdUserItem(string Name, User? DbUser);

    private readonly HashSet<string> _expandedRows = [];

    private static string GetUrl(AdUserItem item) =>
        item.DbUser != null
            ? $"/users/{item.DbUser.Id}"
            : $"/users/name/{Uri.EscapeDataString(item.Name)}";

    private async Task OnRowClick(TableRowClickEventArgs<AdUserItem> args)
    {
        if (args.Item is null) return;
        if (args.MouseEventArgs.CtrlKey || args.MouseEventArgs.MetaKey)
        {
            await JS.InvokeVoidAsync("open", GetUrl(args.Item), "_blank");
            return;
        }
        if (Nested)
        {
            Navigation.NavigateTo(GetUrl(args.Item));
        }
        else
        {
            if (!_expandedRows.Remove(args.Item.Name))
                _expandedRows.Add(args.Item.Name);
        }
    }

    private async Task HandleMouseDown(MouseEventArgs e, AdUserItem item)
    {
        if (e.Button == 1)
            await JS.InvokeVoidAsync("open", GetUrl(item), "_blank");
    }
}

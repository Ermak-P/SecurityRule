@page "/users/create"
@rendermode InteractiveServer
@inject IUserRepository UserRepository
@inject IGroupRepository GroupRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Добавить пользователя</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Добавить пользователя</MudText>

<MudCard>
    <MudCardContent>
        <MudTextField @bind-Value="_user.Name" Label="Название" HelperText="например, domain\user" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_user.Description" Label="Описание" Lines="3" Class="mb-3" />
        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_selectedGroupIds"
                   Label="Группы" Class="mb-3">
            @foreach (var group in _allGroups)
            {
                <MudSelectItem Value="@group.Id">@group.Name</MudSelectItem>
            }
        </MudSelect>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save">Сохранить</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/users"))">Отмена</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private User _user = new();
    private IEnumerable<Group> _allGroups = [];
    private IReadOnlyCollection<int> _selectedGroupIds = [];

    protected override async Task OnInitializedAsync()
    {
        _allGroups = await GroupRepository.GetAllAsync();
    }

    private async Task Save()
    {
        _user.Groups = _allGroups.Where(g => _selectedGroupIds.Contains(g.Id)).ToList();
        await UserRepository.AddAsync(_user);
        Snackbar.Add("Пользователь добавлен", Severity.Success);
        Navigation.NavigateTo("/users");
    }
}

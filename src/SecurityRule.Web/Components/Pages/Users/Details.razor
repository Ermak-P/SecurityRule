@page "/users/{Id:int}"
@rendermode InteractiveServer
@inject IUserRepository UserRepository
@inject IGroupRepository GroupRepository
@inject IAdService AdService
@inject NavigationManager Navigation

@if (_displayUser == null)
{
    @if (!Embedded)
    {
        <PageTitle>Пользователь — ...</PageTitle>
    }
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <PageTitle>Пользователь — @_displayUser.Name</PageTitle>
        <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Tertiary" />
                <MudText Typo="Typo.h4">@_displayUser.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/users/edit/{_displayUser.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Название</MudText>
                    <MudText Typo="Typo.body1">@_displayUser.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Групп (AD)</MudText>
                    <MudText Typo="Typo.body1">@_adGroups.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Сервисов</MudText>
                    <MudText Typo="Typo.body1">@_displayUser.Services.Count</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_displayUser.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Описание</MudText>
                        <MudText Typo="Typo.body1">@_displayUser.Description</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (_adGroups.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Class="mr-1" />
            Группы
        </MudText>
        <MudPaper Elevation="2" Class="overflow-hidden mb-4">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="pa-3">
                @foreach (var item in _adGroups)
                {
                    @if (item.DbGroup != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                 OnClick="@(() => Navigation.NavigateTo($"/groups/{item.DbGroup.Id}"))">
                            @item.Name
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            @item.Name
                        </MudChip>
                    }
                }
            </MudStack>
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Size="Size.Small" Class="mr-1" />
        Сервисы
    </MudText>
    <MudPaper Elevation="2" Class="overflow-hidden">
        <SecurityRule.Web.Components.Pages.Services.Table Items="@_displayUser.Services" Elevation="0" />
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public User? User { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;

    private record AdGroupItem(string Name, Group? DbGroup);

    private User? _displayUser;
    private List<AdGroupItem> _adGroups = [];
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        if (User is not null)
        {
            _displayUser = User;
        }
        else
        {
            _displayUser = await UserRepository.GetByIdAsync(Id);
            _breadcrumbs =
            [
                new BreadcrumbItem("Пользователи", href: "/users"),
                new BreadcrumbItem(_displayUser?.Name ?? Id.ToString(), href: null, disabled: true)
            ];
        }

        if (_displayUser != null)
        {
            var groupNames = await AdService.GetUserGroupNamesAsync(_displayUser.Name);
            var allDbGroups = await GroupRepository.GetAllAsync();
            var dbByName = allDbGroups.ToDictionary(g => g.Name, StringComparer.OrdinalIgnoreCase);
            _adGroups = groupNames
                .Select(n => new AdGroupItem(n, dbByName.TryGetValue(n, out var g) ? g : null))
                .ToList();
        }
    }
}

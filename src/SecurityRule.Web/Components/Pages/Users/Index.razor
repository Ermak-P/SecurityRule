@page "/users"
@rendermode InteractiveServer
@inject IUserRepository UserRepository
@inject NavigationManager Navigation

<PageTitle>Пользователи</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4">Пользователи</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Учётные записи пользователей</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/users/create"))">Добавить</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <Table Items="_users" />
}

@code {
    private IEnumerable<User> _users = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _users = await UserRepository.GetAllAsync();
        _loading = false;
    }
}

@page "/connections/map"
@rendermode InteractiveServer
@using System.Text.Json
@inject IServiceConnectionRepository ServiceConnectionRepository
@inject IServerRepository ServerRepository
@inject IAppServiceRepository AppServiceRepository
@inject GraphMapElementsBuilder ElementsBuilder
@inject IJSRuntime JS

<PageTitle>Карта связей</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 pa-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Карта связей</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @* Hidden server list used by E2E tests to verify options without opening the dropdown *@
    <div style="display:none" data-testid="server-filter-options">
        @foreach (var s in _allServers)
        {
            <span>@s.Name (@s.IpAddress)</span>
        }
    </div>

    @* Hidden list of currently selected servers for E2E assertions *@
    <div style="display:none" data-testid="server-filter-selected">
        @foreach (var srvId in _selectedServerIds)
        {
            var srv = _allServers.FirstOrDefault(s => s.Id == srvId);
            if (srv is not null)
            {
                <span>@srv.Name@(string.IsNullOrWhiteSpace(srv.IpAddress) ? "" : $" ({srv.IpAddress})")</span>
            }
        }
    </div>

    @* Hidden list of currently dimmed (related) servers for E2E assertions *@
    <div style="display:none" data-testid="graph-dimmed-servers">
        @foreach (var srvId in _relatedServerIds)
        {
            var srv = _allServers.First(s => s.Id == srvId);
            <span>@srv.Name@(string.IsNullOrWhiteSpace(srv.IpAddress) ? "" : $" ({srv.IpAddress})")</span>
        }
    </div>

    <MudGrid Spacing="3">
        @* Graph + Legend *@
        <MudItem xs="12" md="9">
            <MudPaper Elevation="1" Style="height: 620px;" data-testid="connections-map-container">
                <div id="cy-container" style="width: 100%; height: 100%;" data-testid="connections-graph"></div>
            </MudPaper>

            @* Legend *@
            <MudPaper Elevation="0" Class="pa-2 mt-2" Style="border: 1px solid #eee;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Обозначения:</MudText>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" fill="#1565c0"/>
                        </svg>
                        <MudText Typo="Typo.caption">Сервер</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" fill="#b0bec5"/>
                        </svg>
                        <MudText Typo="Typo.caption">Связанный сервер</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M14.17,13.71l1.4-2.42c0.09-0.15,0.05-0.34-0.08-0.45l-1.48-1.16c0.03-0.22,0.05-0.45,0.05-0.68s-0.02-0.46-0.05-0.69l1.48-1.16c0.13-0.11,0.17-0.3,0.08-0.45l-1.4-2.42c-0.09-0.15-0.27-0.21-0.43-0.15L12,4.83c-0.36-0.28-0.75-0.51-1.18-0.69l-0.26-1.85C10.53,2.13,10.38,2,10.21,2h-2.8C7.24,2,7.09,2.13,7.06,2.3L6.8,4.15C6.38,4.33,5.98,4.56,5.62,4.84l-1.74-0.7c-0.16-0.06-0.34,0-0.43,0.15l-1.4,2.42C1.96,6.86,2,7.05,2.13,7.16l1.48,1.16C3.58,8.54,3.56,8.77,3.56,9s0.02,0.46,0.05,0.69l-1.48,1.16C2,10.96,1.96,11.15,2.05,11.3l1.4,2.42c0.09,0.15,0.27,0.21,0.43,0.15l1.74-0.7c0.36,0.28,0.75,0.51,1.18,0.69l0.26,1.85C7.09,15.87,7.24,16,7.41,16h2.8c0.17,0,0.32-0.13,0.35-0.3l0.26-1.85c0.42-0.18,0.82-0.41,1.18-0.69l1.74,0.7C13.9,13.92,14.08,13.86,14.17,13.71zM8.81,11c-1.1,0-2-0.9-2-2c0-1.1,0.9-2,2-2s2,0.9,2,2C10.81,10.1,9.91,11,8.81,11z" fill="#1565c0"/>
                            <path d="M21.92,18.67l-0.96-0.74c0.02-0.14,0.04-0.29,0.04-0.44c0-0.15-0.01-0.3-0.04-0.44l0.95-0.74c0.08-0.07,0.11-0.19,0.05-0.29l-0.9-1.55c-0.05-0.1-0.17-0.13-0.28-0.1l-1.11,0.45c-0.23-0.18-0.48-0.33-0.76-0.44l-0.17-1.18C18.73,13.08,18.63,13,18.53,13h-1.79c-0.11,0-0.21,0.08-0.22,0.19l-0.17,1.18c-0.27,0.12-0.53,0.26-0.76,0.44l-1.11-0.45c-0.1-0.04-0.22,0-0.28,0.1l-0.9,1.55c-0.05,0.1-0.04,0.22,0.05,0.29l0.95,0.74c-0.02,0.14-0.03,0.29-0.03,0.44c0,0.15,0.01,0.3,0.03,0.44l-0.95,0.74c-0.08,0.07-0.11,0.19-0.05,0.29l0.9,1.55c0.05,0.1,0.17,0.13,0.28,0.1l1.11-0.45c0.23,0.18,0.48,0.33,0.76,0.44l0.17,1.18c0.02,0.11,0.11,0.19,0.22,0.19h1.79c0.11,0,0.21-0.08,0.22-0.19l0.17-1.18c0.27-0.12,0.53-0.26,0.75-0.44l1.12,0.45c0.1,0.04,0.22,0,0.28-0.1l0.9-1.55C22.03,18.86,22,18.74,21.92,18.67zM17.63,18.83c-0.74,0-1.35-0.6-1.35-1.35s0.6-1.35,1.35-1.35s1.35,0.6,1.35,1.35S18.37,18.83,17.63,18.83z" fill="#1565c0"/>
                        </svg>
                        <MudText Typo="Typo.caption">Сервис</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="leg-srv" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                                    <polygon points="0 0, 6 2.5, 0 5" fill="#1565c0" />
                                </marker>
                            </defs>
                            <line x1="0" y1="6" x2="22" y2="6" stroke="#1565c0" stroke-width="1.5" marker-end="url(#leg-srv)" />
                        </svg>
                        <MudText Typo="Typo.caption">Связь от сервера</MudText>
                    </div>
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                        <svg width="30" height="12" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="leg-svc" markerWidth="6" markerHeight="5" refX="1" refY="2.5" orient="auto">
                                    <polygon points="0 0, 6 2.5, 0 5" fill="#00796b" />
                                </marker>
                            </defs>
                            <line x1="0" y1="6" x2="22" y2="6" stroke="#00796b" stroke-width="1.5" marker-end="url(#leg-svc)" />
                        </svg>
                        <MudText Typo="Typo.caption">Связь от сервиса</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* Filter panel – servers grouped by tag (right side) *@
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Фильтр по серверам:</MudText>
                <MudStack Row="true" Spacing="1" Class="mb-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAll">Выбрать все</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="DeselectAll">Снять все</MudButton>
                </MudStack>
                <div data-testid="server-filter-chips">
                    <MudNavMenu>
                        @foreach (var group in _serversByTag)
                        {
                            var tagSelectedCount = group.Value.Count(s => _selectedServerIds.Contains(s.Id));
                            var groupTitle = $"{group.Key} ({tagSelectedCount})";
                            <MudNavGroup Title="@groupTitle" Expanded="true">
                                @foreach (var s in group.Value)
                                {
                                    var serverId = s.Id;
                                    var isSelected = _selectedServerIds.Contains(serverId);
                                    <MudNavLink Icon="@(isSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)"
                                               OnClick="@(() => ToggleServer(serverId))"
                                               Style="@(isSelected ? "color: var(--mud-palette-primary)" : "color: var(--mud-palette-text-secondary)")">
                                        @s.Name@(string.IsNullOrWhiteSpace(s.IpAddress) ? "" : $" ({s.IpAddress})")
                                    </MudNavLink>
                                }
                            </MudNavGroup>
                        }
                    </MudNavMenu>
                </div>
                <div data-testid="show-related-checkbox">
                    <MudCheckBox T="bool" Value="_showRelated" ValueChanged="OnShowRelatedChanged"
                                 Label="Показывать связанные серверы" Class="mt-2" />
                </div>
                <div data-testid="show-edge-labels-checkbox">
                    <MudCheckBox T="bool" Value="_showEdgeLabels" ValueChanged="OnShowEdgeLabelsChanged"
                                 Label="Показывать порт/протокол" Class="mt-1" />
                </div>
                <div data-testid="show-server-ip-checkbox">
                    <MudCheckBox T="bool" Value="_showServerIp" ValueChanged="OnShowServerIpChanged"
                                 Label="Показывать IP сервера" Class="mt-1" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private sealed record GraphMapSettings(
        bool  ShowRelated,
        bool  ShowEdgeLabels,
        bool  ShowServerIp,
        int[] SelectedServerIds);

    private const string SettingsKey = "graphmap-settings";

    private bool _loading          = true;
    private bool _graphInitialized = false;
    private bool _showRelated      = false;
    private bool _showEdgeLabels   = true;
    private bool _showServerIp     = true;

    private IReadOnlyCollection<int> _selectedServerIds = [];
    private IReadOnlySet<int>        _relatedServerIds  = new HashSet<int>();
    private Dictionary<string, List<Server>> _serversByTag = [];

    private IEnumerable<ServiceConnection> _allConnections = [];
    private IEnumerable<Server>            _allServers     = [];
    private IEnumerable<AppService>        _allServices    = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Связи", href: "/connections"),
        new BreadcrumbItem("Карта", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _allConnections    = await ServiceConnectionRepository.GetAllAsync();
        _allServers        = await ServerRepository.GetAllAsync();
        _allServices       = await AppServiceRepository.GetAllAsync();
        _selectedServerIds = _allServers.Select(s => s.Id).ToList();
        _serversByTag      = BuildServersByTag();
        _loading           = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_graphInitialized)
        {
            _graphInitialized = true;

            await LoadSettingsAsync();

            var result = BuildGraphElements();
            _relatedServerIds = result.RelatedServerIds;
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("graphMap.init", "cy-container", result.Elements);
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SettingsKey);
            if (json is null) return;

            var settings = JsonSerializer.Deserialize<GraphMapSettings>(json);
            if (settings is null) return;

            _showRelated    = settings.ShowRelated;
            _showEdgeLabels = settings.ShowEdgeLabels;
            _showServerIp   = settings.ShowServerIp;

            if (settings.SelectedServerIds.Length > 0)
            {
                var validIds = _allServers.Select(s => s.Id).ToHashSet();
                var filtered = settings.SelectedServerIds.Where(id => validIds.Contains(id)).ToList();
                if (filtered.Count > 0)
                    _selectedServerIds = filtered;
            }
        }
        catch (JsonException) { /* ignore corrupt stored data */ }
    }

    private async Task SaveSettingsAsync()
    {
        var settings = new GraphMapSettings(
            _showRelated,
            _showEdgeLabels,
            _showServerIp,
            _selectedServerIds.ToArray());

        var json = JsonSerializer.Serialize(settings);
        await JS.InvokeVoidAsync("localStorage.setItem", SettingsKey, json);
    }

    private async Task SelectAll()
    {
        _selectedServerIds = _allServers.Select(s => s.Id).ToList();
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task DeselectAll()
    {
        _selectedServerIds = [];
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task ToggleServer(int serverId)
    {
        var current = _selectedServerIds.ToHashSet();
        if (!current.Remove(serverId))
            current.Add(serverId);
        _selectedServerIds = current;
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task OnServersChanged(IReadOnlyCollection<int> values)
    {
        _selectedServerIds = values;
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task OnShowRelatedChanged(bool value)
    {
        _showRelated = value;
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task OnShowEdgeLabelsChanged(bool value)
    {
        _showEdgeLabels = value;
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task OnShowServerIpChanged(bool value)
    {
        _showServerIp = value;
        await RefreshGraph();
        await SaveSettingsAsync();
    }

    private async Task RefreshGraph()
    {
        if (!_graphInitialized) return;

        var result = BuildGraphElements();
        _relatedServerIds = result.RelatedServerIds;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("graphMap.update", result.Elements);
    }

    private Dictionary<string, List<Server>> BuildServersByTag()
    {
        var result = new Dictionary<string, List<Server>>();
        foreach (var server in _allServers)
        {
            var tags = server.Tags.Select(t => t.Name).ToList();
            if (tags.Count == 0)
                tags.Add("Без тега");
            foreach (var tag in tags)
            {
                if (!result.TryGetValue(tag, out var list))
                    result[tag] = list = [];
                list.Add(server);
            }
        }
        return result;
    }

    private GraphMapResult BuildGraphElements()
        => ElementsBuilder.Build(_allConnections, _allServers, _allServices, _selectedServerIds, _showRelated, _showEdgeLabels, _showServerIp);
}

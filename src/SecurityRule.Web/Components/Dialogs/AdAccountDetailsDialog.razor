@inject IAdAccountRepository AdAccountRepository

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(_account?.Name ?? AccountName)</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (_account == null)
        {
            <MudText Color="Color.Secondary">Подробные сведения об учётной записи не найдены.</MudText>
            @if (!string.IsNullOrWhiteSpace(AccountName))
            {
                <MudGrid Class="mt-2">
                    <MudItem xs="4"><MudText Color="Color.Secondary">Название</MudText></MudItem>
                    <MudItem xs="8"><MudText>@AccountName</MudText></MudItem>
                </MudGrid>
            }
        }
        else
        {
            <MudGrid>
                <MudItem xs="4"><MudText Color="Color.Secondary">Название</MudText></MudItem>
                <MudItem xs="8"><MudText>@_account.Name</MudText></MudItem>
                @if (!string.IsNullOrWhiteSpace(_account.Description))
                {
                    <MudItem xs="4"><MudText Color="Color.Secondary">Описание</MudText></MudItem>
                    <MudItem xs="8"><MudText>@_account.Description</MudText></MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Class="mr-1" />
                Группы (@_account.Groups.Count)
            </MudText>
            @if (!_account.Groups.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Нет групп</MudText>
            }
            else
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                    @foreach (var group in _account.Groups)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @group.Name
                        </MudChip>
                    }
                </MudStack>
            }

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Class="mr-1" />
                Серверы (@AllServers.Count)
            </MudText>
            @if (!AllServers.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Нет серверов</MudText>
            }
            else
            {
                @foreach (var srv in AllServers)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Color="Color.Primary" />
                        <MudText Style="flex:1">@srv.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@srv.IpAddress</MudText>
                    </MudStack>
                }
            }

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="mr-1" />
                Сертификаты (@AllCertificates.Count)
            </MudText>
            @if (!AllCertificates.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Нет сертификатов</MudText>
            }
            else
            {
                @foreach (var cert in AllCertificates)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Warning" />
                        <MudText Style="flex:1">@cert.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            до @cert.ExpiresAt.ToString("dd.MM.yyyy")
                        </MudText>
                    </MudStack>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Close())">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? AdAccountId { get; set; }
    [Parameter] public string AccountName { get; set; } = string.Empty;

    private AdAccount? _account;
    private bool _loading = true;

    private List<Server> AllServers => _account?.Services
        .SelectMany(s => s.Servers).DistinctBy(s => s.Id).ToList() ?? [];

    private List<Certificate> AllCertificates => _account?.Services
        .SelectMany(s => s.Certificates).DistinctBy(c => c.Id).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (AdAccountId.HasValue)
            _account = await AdAccountRepository.GetByIdAsync(AdAccountId.Value);
        _loading = false;
    }
}

@using SecurityRule.Web.Services

<MudDialog ContentClass="pa-0">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icon" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight:600; letter-spacing:.2px;">@DialogTitle</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>

        @* ── Search ──────────────────────────────────────────────────── *@
        <div class="px-4 pt-4 pb-2">
            <MudTextField @bind-Value="_filter"
                          Label="@SearchLabel"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          FullWidth="true"
                          data-testid="@($"{TestIdPrefix}-search")" />
        </div>

        @* ── Available items table ───────────────────────────────────── *@
        @if (!_state.AvailableItems.Any())
        {
            @* Empty-state: no data *@
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyMessage</MudText>
            </MudStack>
        }
        else
        {
            <div class="dict-available-list" data-testid="@($"{TestIdPrefix}-list")">
                <MudTable T="string"
                          Items="@_filteredAvailableItems"
                          Dense="true"
                          Hover="true"
                          FixedHeader="true"
                          Height="260px"
                          Elevation="0"
                          RowClassFunc="@((item, _) => _fadingOutAvailable.Contains(item) ? "dict-row-exit"
                                                    : _fadingInAvailable.Contains(item) ? "dict-row-appear" : "")">
                    <HeaderContent>
                        <MudTh Style="width:40px; padding:4px 0 4px 12px;">
                            <MudCheckBox T="bool"
                                         Value="@_allFilteredSelected"
                                         Indeterminate="@_someFilteredSelected"
                                         ValueChanged="@ToggleAll"
                                         Color="Color.Primary"
                                         data-testid="@($"{TestIdPrefix}-select-all")" />
                        </MudTh>
                        <MudTh Style="padding:4px 16px 4px 4px;">
                            <MudText Typo="Typo.body2" Style="font-weight:600;">Название</MudText>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="width:40px; padding:2px 0 2px 12px; cursor:pointer;"
                               @onclick="@(() => ToggleAsync(context))">
                            <MudCheckBox T="bool"
                                         Value="false"
                                         ValueChanged="@(_ => ToggleAsync(context))"
                                         Color="Color.Primary"
                                         StopClickPropagation="true"
                                         data-testid="@($"{TestIdPrefix}-item-{context}")" />
                        </MudTd>
                        <MudTd Style="padding:2px 16px 2px 4px; cursor:pointer;"
                               @onclick="@(() => ToggleAsync(context))">
                            <MudText Typo="Typo.body2">@context</MudText>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Class="py-4" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Secondary" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">По запросу ничего не найдено</MudText>
                        </MudStack>
                    </NoRecordsContent>
                </MudTable>
            </div>
        }

        @* ── Selected items table (always visible) ───────────────────── *@
        <MudDivider />
        <div class="dict-selected-list" data-testid="@($"{TestIdPrefix}-selected-table")">
            <MudTable T="string"
                      Items="@_state.SelectedNames.OrderBy(n => n).ToList()"
                      Dense="true"
                      Hover="true"
                      FixedHeader="true"
                      Height="160px"
                      Elevation="0"
                      RowClassFunc="@((item, _) => _fadingOutSelected.Contains(item) ? "dict-row-exit"
                                                : _fadingInSelected.Contains(item) ? "dict-row-appear" : "")">
                <HeaderContent>
                    <MudTh Style="width:40px; padding:4px 0 4px 12px;" />
                    <MudTh Style="padding:4px 16px 4px 4px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="font-weight:600; flex:1;">@SelectedSectionLabel</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                     Variant="Variant.Filled" DisableRipple="true"
                                     Style="@(_state.SelectedNames.Count == 0 ? "visibility:hidden;" : "")">
                                @_state.SelectedNames.Count
                            </MudChip>
                        </MudStack>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="width:40px; padding:2px 0 2px 12px; cursor:pointer;"
                           @onclick="@(() => RemoveAsync(context))">
                        <MudCheckBox T="bool"
                                     Value="true"
                                     ValueChanged="@(_ => RemoveAsync(context))"
                                     Color="Color.Primary"
                                     StopClickPropagation="true"
                                     data-testid="@($"{TestIdPrefix}-remove-{context}")" />
                    </MudTd>
                    <MudTd Style="padding:2px 16px 2px 4px; cursor:pointer;"
                           @onclick="@(() => RemoveAsync(context))">
                        <MudText Typo="Typo.body2">@context</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Class="py-3" Spacing="1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Ничего не выбрано</MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudTable>
        </div>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="Cancel"
                   data-testid="@($"{TestIdPrefix}-dialog-cancel")">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.Check"
                   OnClick="Ok"
                   data-testid="@($"{TestIdPrefix}-dialog-ok")">
            OK
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>All item names loaded from the database.</summary>
    [Parameter] public IEnumerable<string> AllItems { get; set; } = [];

    /// <summary>Names of items already selected before the dialog opened.</summary>
    [Parameter] public IEnumerable<string> PreSelected { get; set; } = [];

    /// <summary>Title text shown in the dialog header.</summary>
    [Parameter] public string DialogTitle { get; set; } = "Выбор";

    /// <summary>MudBlazor icon shown next to the dialog title.</summary>
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.List;

    /// <summary>Label for the search field.</summary>
    [Parameter] public string SearchLabel { get; set; } = "Поиск";

    /// <summary>Message shown when the item list is empty.</summary>
    [Parameter] public string EmptyMessage { get; set; } = "Список пуст";

    /// <summary>Label for the selected-items section.</summary>
    [Parameter] public string SelectedSectionLabel { get; set; } = "Выбранные";

    /// <summary>Prefix used for all data-testid attributes (e.g. "partner" → "partner-list").</summary>
    [Parameter] public string TestIdPrefix { get; set; } = "dictionary";

    private DictionaryInputState _state = new([]);
    private string _filter = string.Empty;
    private readonly HashSet<string> _fadingOutAvailable = new();
    private readonly HashSet<string> _fadingOutSelected = new();
    private readonly HashSet<string> _fadingInAvailable = new();
    private readonly HashSet<string> _fadingInSelected = new();

    /// <summary>
    /// Items shown in the available table: only unselected items, plus any that are
    /// mid-exit animation (still visible until the CSS animation finishes).
    /// </summary>
    private IReadOnlyList<string> _filteredAvailableItems =>
        _state.FilteredItems(_filter)
              .Where(i => !_state.IsSelected(i) || _fadingOutAvailable.Contains(i))
              .ToList();

    /// <summary>All items matching the current filter, for header-checkbox logic.</summary>
    private IReadOnlyList<string> _allItemsMatchingFilter =>
        _state.FilteredItems(_filter).ToList();

    /// <summary>True when every item matching the current filter is selected.</summary>
    private bool _allFilteredSelected =>
        _allItemsMatchingFilter.Count > 0 && _allItemsMatchingFilter.All(n => _state.IsSelected(n));

    /// <summary>True when some (but not all) items matching the filter are selected.</summary>
    private bool _someFilteredSelected =>
        _allItemsMatchingFilter.Any(n => _state.IsSelected(n)) && !_allFilteredSelected;

    protected override void OnParametersSet()
    {
        _state = new DictionaryInputState(AllItems, PreSelected);
    }

    /// <summary>
    /// Plays the exit animation on the available-list row, moves the item to the selected
    /// list with an enter animation, then clears the animation class.
    /// Ignored when the item is already animating.
    /// </summary>
    private async Task ToggleAsync(string item)
    {
        if (_fadingOutAvailable.Contains(item)) return;
        _fadingOutAvailable.Add(item);
        StateHasChanged();
        await Task.Delay(150);
        _state.Toggle(item);
        _fadingOutAvailable.Remove(item);
        _fadingInSelected.Add(item);
        StateHasChanged();
        await Task.Delay(200);
        _fadingInSelected.Remove(item);
        StateHasChanged();
    }

    /// <summary>
    /// Plays the exit animation on the selected-list row, moves the item back to the
    /// available list with an enter animation, then clears the animation class.
    /// Ignored when the item is already animating.
    /// </summary>
    private async Task RemoveAsync(string item)
    {
        if (_fadingOutSelected.Contains(item)) return;
        _fadingOutSelected.Add(item);
        StateHasChanged();
        await Task.Delay(150);
        _state.Remove(item);
        _fadingOutSelected.Remove(item);
        _fadingInAvailable.Add(item);
        StateHasChanged();
        await Task.Delay(200);
        _fadingInAvailable.Remove(item);
        StateHasChanged();
    }

    private void ToggleAll(bool _)
    {
        if (_allFilteredSelected)
            foreach (var item in _allItemsMatchingFilter.ToList())
                _state.Remove(item);
        else
            _state.SelectAll(_filter);
    }

    private void Ok()     => MudDialog.Close(DialogResult.Ok(_state.SelectedNames.ToHashSet()));
    private void Cancel() => MudDialog.Cancel();
}

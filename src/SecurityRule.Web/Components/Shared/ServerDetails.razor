@using SecurityRule.Web.Components.Pages.Services
@inject NavigationManager Navigation

@if (Server == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" />
                <MudText Typo="Typo.h4">@Server.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/servers/edit/{Server.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">IP адрес</MudText>
                    <MudText Typo="Typo.body1">@Server.IpAddress</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Операционная система</MudText>
                    <MudText Typo="Typo.body1">@Server.OperatingSystem</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Количество сервисов</MudText>
                    <MudText Typo="Typo.body1">@Server.Services.Count</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(Server.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Описание</MudText>
                        <MudText Typo="Typo.body1">@Server.Description</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Size="Size.Small" Class="mr-1" />
        Сервисы
    </MudText>
    <Index Items="@Server.Services" Embedded="true" />
}

@code {
    [Parameter] public Server? Server { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;
}

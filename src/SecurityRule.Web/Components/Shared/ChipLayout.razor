@using MudBlazor

<div class="d-flex align-items-start gap-1 @Class">
    <div class="flex-grow-1 @(_isColumn ? "chip-layout-column" : "")">
        @ChildContent
    </div>
    <MudTooltip Text="@(_isColumn ? "Расположить строкой" : "Расположить столбиком")" Placement="Placement.Left">
        <MudIconButton Icon="@(_isColumn ? Icons.Material.Outlined.ViewStream : Icons.Material.Outlined.ViewList)"
                       Size="Size.Small"
                       Color="Color.Default"
                       OnClick="@Toggle" />
    </MudTooltip>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = "";

    /// <summary>Initial orientation: true = column, false = row (default).</summary>
    [Parameter] public bool IsColumn { get; set; } = false;
    [Parameter] public EventCallback<bool> IsColumnChanged { get; set; }

    private bool _isColumn;

    protected override void OnParametersSet()
    {
        _isColumn = IsColumn;
    }

    private async Task Toggle()
    {
        _isColumn = !_isColumn;
        await IsColumnChanged.InvokeAsync(_isColumn);
    }
}

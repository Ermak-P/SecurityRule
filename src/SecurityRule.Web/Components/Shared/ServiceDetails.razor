@using SecurityRule.Web.Components.Pages.Servers
@inject NavigationManager Navigation

@if (Service == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!Embedded)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Color="Color.Secondary" />
                <MudText Typo="Typo.h4">@Service.Name</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/services/edit/{Service.Id}"))">
                Редактировать
            </MudButton>
        </MudStack>
    }

    <MudCard Class="mb-4" Elevation="@(Embedded ? 0 : 1)">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">AD учётная запись</MudText>
                    <MudText Typo="Typo.body1">@Service.AdAccountName</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Серверов</MudText>
                    <MudText Typo="Typo.body1">@Service.Servers.Count</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Сертификатов</MudText>
                    <MudText Typo="Typo.body1">@Service.Certificates.Count</MudText>
                </MudItem>
            </MudGrid>
            @if (Service.Certificates.Any())
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Class="mb-2"><strong>Сертификаты:</strong></MudText>
                @foreach (var cert in Service.Certificates)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">
                        @cert.Description (@cert.ExpiresAt.ToString("dd.MM.yyyy"))
                    </MudChip>
                }
            }
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Class="mr-1" />
        Серверы
    </MudText>
    <Index Items="@Service.Servers" Embedded="true" />
}

@code {
    [Parameter] public AppService? Service { get; set; }
    [Parameter] public bool Embedded { get; set; } = false;
}

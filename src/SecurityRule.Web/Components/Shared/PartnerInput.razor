@using MudBlazor
@using SecurityRule.Domain.Interfaces
@inject IPartnerNameRepository PartnerNameRepository

<DictionaryInput Label="@Label"
                 Class="@Class"
                 SelectedItems="SelectedPartners"
                 SelectedItemsChanged="OnSelectedItemsChanged"
                 FetchItemsAsync="FetchPartnersAsync"
                 DialogTitle="Выбор партнёров"
                 DialogIcon="@Icons.Material.Filled.Handshake"
                 EmptyMessage="Список партнёров пуст"
                 SelectedSectionLabel="Выбранные партнёры"
                 TestIdPrefix="partner" />

@code {
    [Parameter] public string Label { get; set; } = "Partner Name";
    [Parameter] public string Class { get; set; } = "";

    /// <summary>Currently selected partner names — two-way bindable.</summary>
    [Parameter] public HashSet<string> SelectedPartners { get; set; } = [];
    [Parameter] public EventCallback<HashSet<string>> SelectedPartnersChanged { get; set; }

    private async Task<IEnumerable<string>> FetchPartnersAsync()
    {
        var partners = await PartnerNameRepository.GetAllAsync();
        return partners.Select(p => p.Name);
    }

    private async Task OnSelectedItemsChanged(HashSet<string> items)
    {
        SelectedPartners = items;
        await SelectedPartnersChanged.InvokeAsync(SelectedPartners);
    }
}

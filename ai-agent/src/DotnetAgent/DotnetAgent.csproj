<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тип проекта: исполняемое консольное приложение -->
    <OutputType>Exe</OutputType>

    <!-- Целевой фреймворк: .NET 9 -->
    <TargetFramework>net9.0</TargetFramework>

    <!-- Включить nullable reference types — помогает избежать NullReferenceException -->
    <Nullable>enable</Nullable>

    <!-- Автоматически добавлять стандартные using (System, System.IO и т.д.) -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Название сборки -->
    <AssemblyName>DotnetAgent</AssemblyName>
    <RootNamespace>DotnetAgent</RootNamespace>
  </PropertyGroup>

  <!--
    ЗАВИСИМОСТИ (NuGet пакеты)
    
    На данном этапе мы намеренно НЕ добавляем внешние пакеты.
    Всё необходимое (HttpClient, System.Text.Json) уже входит в .NET 9.
    
    В будущих фазах можно добавить:
    
    Фаза 2 — анализ кода через Roslyn:
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    
    Фаза 3 — официальный .NET AI абстракционный слой:
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" Version="9.*" />
    
    Фаза 4 — работа с Git:
    <PackageReference Include="LibGit2Sharp" Version="0.*" />
  -->

</Project>

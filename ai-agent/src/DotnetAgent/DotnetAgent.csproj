<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тип проекта: исполняемое консольное приложение -->
    <OutputType>Exe</OutputType>

    <!-- Целевой фреймворк: .NET 9 -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Включить nullable reference types — помогает избежать NullReferenceException -->
    <Nullable>enable</Nullable>

    <!-- Автоматически добавлять стандартные using (System, System.IO и т.д.) -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Название сборки -->
    <AssemblyName>DotnetAgent</AssemblyName>
    <RootNamespace>DotnetAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Фаза 2 — анализ кода через Roslyn (AST, классы, методы) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />

    <!-- Фаза 3 — SQLite для хранения сессий -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />

    <!-- Фаза 4 — работа с Git -->
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
  </ItemGroup>

</Project>
